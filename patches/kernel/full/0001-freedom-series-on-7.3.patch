+        return -EFAULT;
+    } else if (argc > 1) {
+        if (strncasecmp(argv[1], "flash", 5) == 0)
+            to_flash = true;
+        else if (strncasecmp(argv[1], "sram", 4) == 0)
+            to_flash = false;
