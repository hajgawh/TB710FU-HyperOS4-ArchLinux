From 5371bd358cb92287f64857c375bd831c01a1447c Mon Sep 17 00:00:00 2001
From: tb <tb@local>
Date: Tue, 27 Oct 2026 04:19:28 +0000
Subject: [PATCH 05/27] tb710fu 7.3: add clk_core.orphan_reparent_failed and
 rpmhpd skip_retention/presync fields

---
 drivers/clk/clk.c              | 1 +
 drivers/pmdomain/qcom/rpmhpd.c | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
index 960d19a98..79fd46ca8 100644
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -115,6 +115,7 @@ struct clk_parent_map {
  *
  */
 struct clk_core {
+	bool			orphan_reparent_failed;
 	const char		*name;
 	const struct clk_ops	*ops;
 	struct clk_hw		*hw;
diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
index fcbede238..17c0387ce 100644
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -57,6 +57,8 @@ struct rpmhpd {
 	const char	*res_name;
 	u32		addr;
 	bool		state_synced;
+	bool		skip_retention_level;
+	bool		presync_floor;
 };
 
