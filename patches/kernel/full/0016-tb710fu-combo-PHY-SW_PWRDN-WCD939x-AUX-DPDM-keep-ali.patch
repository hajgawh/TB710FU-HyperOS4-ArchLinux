 {
 	struct qmp_combo *qmp = typec_mux_get_drvdata(mux);
-	const struct qmp_phy_cfg *cfg = qmp->cfg;
 	enum qmpphy_mode new_mode;
 	unsigned int svid;
 
@@ -4838,48 +4956,35 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 	}
 
 	if (new_mode == qmp->qmpphy_mode) {
+		/* The latest firmware state is the current one: any switch we
+		 * deferred earlier is stale. */
+		qmp->tb_mux_pending = false;
 		dev_dbg(qmp->dev, "typec_mux_set: same qmpphy mode, bail out\n");
 		return 0;
 	}
 
-	if (qmp->qmpphy_mode != QMPPHY_MODE_USB3_ONLY && qmp->dp_powered_on) {
-		dev_dbg(qmp->dev, "typec_mux_set: DP PHY is still in use, delaying switch\n");
+	/*
+	 * Do not power-cycle the whole COM block while the DP PHY is held open.
+	 * The DP driver may be mid init or about to run phy_power_on(); a rebuild
+	 * underneath it leaves the DP PLL dead (-16) and dwc3 then halts on a
+	 * block that is routed to DP (xhci -110).
+	 *
+	 * Switching away from DP (USB3_ONLY) is deferred until dp_exit() drops
+	 * dp_init_count to zero; qmp_combo_tb_mux_work() replays it.  A switch
+	 * that includes DP (DP_ONLY/USB3DP) still has to be applied immediately,
+	 * otherwise DP init would run on a USB3-routed block.
+	 */
+	if (qmp->dp_powered_on ||
+	    (qmp->dp_init_count && new_mode == QMPPHY_MODE_USB3_ONLY)) {
+		qmp->tb_pending_mode = new_mode;
+		qmp->tb_mux_pending = true;
+		dev_dbg(qmp->dev,
+			"typec_mux_set: DP PHY busy (init=%u powered=%d), deferring mode %d\n",
+			qmp->dp_init_count, qmp->dp_powered_on, new_mode);
 		return 0;
 	}
 
-	dev_dbg(qmp->dev, "typec_mux_set: switching from qmpphy mode %d to %d\n",
-		qmp->qmpphy_mode, new_mode);
-
-	qmp->qmpphy_mode = new_mode;
-
-	if (qmp->init_count) {
-		if (qmp->usb_init_count)
