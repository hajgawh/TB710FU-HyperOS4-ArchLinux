 		goto exit;
 	}
 
+	/*
+	 * TB710FU: the link bring-up arms a total budget before it starts
+	 * talking to the sink.  Without it a dead AUX PHY turns every DPCD
+	 * message into 32 x 250 ms of retries inside drm_dp_dpcd_access(),
+	 * which wedges the atomic commit thread for far longer than the PMIC
+	 * watchdog tolerates.  Once the budget is gone, fail fast so the
+	 * commit can finish (DP stays off until the next real plug).
+	 */
+	if (aux->tb_budget_end && time_after(jiffies, aux->tb_budget_end)) {
+		ret = -ETIMEDOUT;
+		goto exit;
+	}
