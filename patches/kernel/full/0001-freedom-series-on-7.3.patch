+#define CTP_IOCTL_MAGIC			    0x13
+#define CTP_IOCTL_PROX_ON  		    _IOW(CTP_IOCTL_MAGIC, 1, int)
+#define CTP_IOCTL_PROX_OFF		    _IOW(CTP_IOCTL_MAGIC, 2, int)
+#define CTP_PROXIMITY_DEVICE_NAME	"ltr_558als"                 //match HAL name
