+    if (0 == txlen) {
+        cts_err("spi read pack len: %d", txlen);
+        return -EINVAL;
+    }
+    ret = cts_tcs_spi_xtrans_1_cs(cts_dev, cts_dev->pdata->spi_tx_buf, txlen,
+            cts_dev->pdata->spi_rx_buf, rdatalen);
+    if (ret) {
+        return ret;
