+/ {
+	model = "AYN Thor Lite";
+	compatible = "ayn,thor-lite", "qcom,sm8250";
+
+	aliases {
+		serial0 = &uart12;
+		serial1 = &uart6;
+		serial2 = &uart16;
+		sdhc2 = &sdhc_2;
+	};
+
+	battery: battery {
+		compatible = "simple-battery";
+
+		charge-full-design-microamp-hours = <3850000>;
+		voltage-min-design-microvolt = <3600000>;
+		voltage-max-design-microvolt = <4400000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		cooling-levels = <0 32 64 128 255>;
+		#cooling-cells = <2>;
+		fan-supply = <&vreg_fan_pwr>;
+		pwms = <&pm8150l_lpg 4 40000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&fan_pwm_active>;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_up_default>;
+
+		key-vol-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	gpio-keys-ayn {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_ayn_n>;
+
+		key-ayn {
+			label = "AYN Key";
+			gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_F24>;
+			debounce-interval = <15>;
+			linux,can-disable;
+		};
+	};
+
+	gpio-keys-lid {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hall_sensor_default>;
+
+		hall-sensor {
+			label = "Hall Sensor";
+			gpios = <&tlmm 123 GPIO_ACTIVE_LOW>;
