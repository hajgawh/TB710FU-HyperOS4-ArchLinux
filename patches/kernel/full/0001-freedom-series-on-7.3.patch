+		pinctrl-names = "default";
+		pinctrl-0 = <&mcu_key_pins>;
+
+		mcu-power-gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
+		mcu-reset-gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+		mcu-boot0-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
+		mcu-boot1-gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
+		stick-en-gpios = <&tlmm 72 GPIO_ACTIVE_LOW>;
+		key-back-gpios = <&tlmm 4 GPIO_ACTIVE_LOW>;
+		key-home-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;
+		key-select-gpios = <&tlmm 83 GPIO_ACTIVE_LOW>;
+		key-start-gpios = <&tlmm 84 GPIO_ACTIVE_LOW>;
+		key-irq-gpios = <&tlmm 63 GPIO_ACTIVE_HIGH>;
+		adc-irq-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+	};
