+
+	periph_en: periph-en-state {
+		pins = "gpio119";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	qup_uart4_default: qup-uart4-default-state {
+		pins = "gpio10", "gpio11";
+		function = "qup4";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	sdc2_default_state: sdc2-default-state {
