diff --git a/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pocketevo.dts b/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pocketevo.dts
new file mode 100644
index 000000000..206d5b8d8
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pocketevo.dts
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2025, Teguh Sobirin.
+ * Copyright (c) 2025, ROCKNIX (https://github.com/ROCKNIX)
+ */
+
+/dts-v1/;
+
+#include "qcs8550-ayaneo-pocket-common.dtsi"
+
+/ {
+	model = "AYANEO Pocket EVO";
+	qcom,board-id = <0x1000b 0x01>;
+	qcom,msm-id = <0x258 0x20000>, <0x259 0x20000>;
+	compatible = "ayaneo,pocketevo", "qcom,qcs8550", "qcom,sm8550";
+	rocknix-u-boot-dt-id = "u-boot-pocket-evo";
+
+	/*
+	 * AYA SPACE, =, LC and RC hang off SoC GPIOs rather than the
+	 * controller MCU. Kept separate from the gpio-keys node in the
+	 * common dtsi because InputPlumber grabs the source devices it
+	 * manages, and sharing that node would swallow volume up.
+	 *
+	 * F13-F16 rather than the vendor's KEY_A/KEY_EQUAL/KEY_LEFT/
+	 * KEY_RIGHTSHIFT: those type real characters, so they would leak
+	 * into whatever has focus whenever InputPlumber is not grabbing
+	 * the node. The label is what InputPlumber matches on.
+	 */
+	aya-keys {
+		compatible = "gpio-keys";
+		label = "aya-keys";
+
+		pinctrl-0 = <&aya_keys_default>;
+		pinctrl-names = "default";
+
+		key-aya-space {
+			label = "AYA Space";
+			debounce-interval = <15>;
+			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_F13>;
+		};
+
+		key-menu {
+			label = "Menu";
+			debounce-interval = <15>;
+			gpios = <&tlmm 169 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_F14>;
+		};
+
+		/* Silkscreen LC; the vendor device tree calls this rc2_key. */
+		key-lc {
+			label = "LC";
+			debounce-interval = <15>;
+			gpios = <&tlmm 170 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_F15>;
+		};
+
+		/* Silkscreen RC; the vendor device tree calls this lc_key. */
+		key-rc {
+			label = "RC";
+			debounce-interval = <15>;
+			gpios = <&tlmm 91 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_F16>;
+		};
+	};
+};
+
+&tlmm {
+	/*
+	 * The buttons short to ground, so without the pull-up these read low
+	 * pressed and unpressed alike and no press is detectable.
+	 */
+	aya_keys_default: aya-keys-default-state {
+		pins = "gpio85", "gpio91", "gpio169", "gpio170";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	panel_pwr_active: panel-pwr-active-state {
+		pins = "gpio152", "gpio153";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	ts_reset_active: ts-reset-active-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	ts_reset_suspend: ts-reset-suspend-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	ts_int_active: ts-int-default-state {
+		pins = "gpio25";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <8>;
+	};
+
+	ts_int_suspend: ts-int-sleep-state {
+		pins = "gpio25";
+		function = "gpio";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+};
+
+&i2c0 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+};
+
+&i2c4 {
+	clock-frequency = <400000>;
+	status = "okay";
+	touchscreen: touchscreen@38 {
+		compatible = "focaltech,ft5426";
+		reg = <0x38>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <25 IRQ_TYPE_EDGE_FALLING>;
+
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+
+		vcc-supply = <&vreg_l14b_3p2>;
+		iovcc-supply = <&vreg_l12b_1p8>;
+
+		pinctrl-0 = <&ts_int_active &ts_reset_active>;
+		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
+		pinctrl-names = "default", "sleep";
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel0_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&display_panel {
+	compatible = "chipone,icna3512";
+
+	vci-supply = <&vreg_l13b_3p0>;
+	vddio-supply = <&vreg_l12b_1p8>;
+
+	reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;
+
+	rotation = <270>;
+
+	port {
+		panel0_in: endpoint {
+			remote-endpoint = <&mdss_dsi0_out>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pockets1k.dts b/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pockets1k.dts
new file mode 100644
index 000000000..2ee17b067
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pockets1k.dts
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2024 Linaro Limited
+ * Copyright (c) 2025, Kancy Joe <kancy2333@outlook.com>
+ * Copyright (c) 2025, ROCKNIX (https://github.com/ROCKNIX)
+ *
+ * AYANEO Pocket S 1K - 1920x1080@60Hz WT0600 video mode panel
+ * Derived from qcs8550-ayaneo-pockets2k.dts
+ *
+ * GPIO layout and power sequence validated from stock Android DTB dump:
+ *   - Panel power: SGM3804 (i2c0, 0x3e) + GPIO 72/42/152/153
+ *   - Backlight: SY7758 (i2c0, 0x2e) + GPIO 41
+ *   - Touch: Goodix GT911 (i2c4, 0x5d) + GPIO 24/25
+ *   - Panel reset: GPIO 133
+ *
+ * Panel timing extracted from stock DT overlay fragment:
+ *   qcom,mdss_dsi_wt0600_1080p_60hz_video
+ */
+
+/dts-v1/;
+
+#include "qcs8550-ayaneo-pocket-common.dtsi"
+
+/ {
+	model = "AYANEO Pocket S 1K";
+	compatible = "ayaneo,pocket-s1", "qcom,sm8550";
+	chassis-type = "handset";
+};
+
+&tlmm {
+	panel_pwr_active: panel-pwr-active-state {
+		pins = "gpio72", "gpio42", "gpio152", "gpio153";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	panel_pwr_sleep: panel-pwr-sleep-state {
+		pins = "gpio72", "gpio42", "gpio152", "gpio153";
+		function = "gpio";
+		output-low;
+	};
+
+	backlight_pwr_active: backlight-pwr-active-state {
+		pins = "gpio41";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	backlight_pwr_sleep: backlight-pwr-sleep-state {
+		pins = "gpio41";
+		function = "gpio";
+		output-low;
+	};
+
+	ts_irq: ts-irq-state {
+		pins = "gpio25";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		input-enable;
+	};
+
+	ts_reset: ts-reset-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <8>;
+		input-enable;
+		bias-pull-down;
+	};
+};
+
+&i2c0 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* Screen power */
+	sgm3804: regulator@3e {
+		compatible = "sgmicro,sgm3804";
+		reg = <0x3e>;
+		pinctrl-0 = <&panel_pwr_active>;
+		pinctrl-1 = <&panel_pwr_sleep>;
+		pinctrl-names = "default", "sleep";
+		regulator-name = "panel-avdd";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		reset-gpios = <&tlmm 152 GPIO_ACTIVE_HIGH>, <&tlmm 153 GPIO_ACTIVE_HIGH>;
+	};
+
+	/* Backlight */
+	backlight: sy7758@2e {
+		compatible = "silergy,sy7758";
+		reg = <0x2e>;
+		/* single-pin backlight: gpio41 is the enable; no separate vdd rail to gate */
+		enable-gpios = <&tlmm 41 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+&i2c4 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	touchscreen@5d {
+		reg = <0x5d>;
+		status = "okay";
+		compatible = "goodix,gt911";
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <25 IRQ_TYPE_EDGE_FALLING>;
+
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+		VDDIO-supply = <&vreg_l14b_3p2>;
+		AVDD28-supply = <&vreg_l14b_3p2>;
+
+		goodix,native-size-x = <1440>;
+		goodix,native-size-y = <2560>;
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ts_reset>, <&ts_irq>;
+	};
+};
+
+/*
+ * WT0600 1080p 60Hz video mode panel
+ * Single DSI, 4-lane DPHY, video mode
+ */
+&mdss_dsi0_out {
+	remote-endpoint = <&panel0_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l1e_0p88>;
+	status = "okay";
+};
+
+&display_panel {
+	status = "okay";
+	compatible = "ayaneo,wt0600-1080p-60hz";
+
+	avdd-supply = <&sgm3804>;
+
+	reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;
+	backlight = <&backlight>;
+	rotation = <90>;
+
+	port {
+		panel0_in: endpoint {
+			remote-endpoint = <&mdss_dsi0_out>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pockets2k.dts b/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pockets2k.dts
