+		regulator-boot-on;
+
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	display_sec_panel_vddio: display-sec-panel-vddio-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "display_sec_panel_vddio";
+
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-enable-ramp-delay = <233>;
+
+		gpio = <&tlmm 97 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+
+		regulator-state-mem {
+			regulator-off-in-suspend;
+		};
+	};
+
+	vdd_bl_5v0: vdd-bl-5v0-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_bl_5v0";
+
+		pinctrl-0 = <&vdd_bl_5v0_active>;
+		pinctrl-1 = <&vdd_bl_5v0_suspend>;
+		pinctrl-names = "default", "sleep";
+
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+
+		gpio = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	mipi_vdd: mipi-vdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "mipi_vdd";
+
+		pinctrl-0 = <&mipi_vdd_active>;
+		pinctrl-1 = <&mipi_vdd_suspend>;
+		pinctrl-names = "default", "sleep";
+
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+
+		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+
+               regulator-state-mem {
+                       regulator-off-in-suspend;
+               };
+	};
+
+	vreg_s4a_1p8: vreg-s4a-1p8 {
+		compatible = "regulator-fixed";
