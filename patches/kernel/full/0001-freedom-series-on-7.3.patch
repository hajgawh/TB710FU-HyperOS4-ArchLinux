+        }
+
+        ret = cts_plat_spi_read_delay_idle(cts_dev->pdata,
+                cts_dev->rtdata.slave_addr, addr_buf,
+                cts_dev->rtdata.addr_width,
+                dst, xfer_len, retry, delay, idle);
+        if (ret) {
+            cts_err("Platform i2c read failed %d", ret);
+            return ret;
+        }
+
+        dst += xfer_len;
