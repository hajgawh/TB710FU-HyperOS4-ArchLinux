@@ -2434,6 +2476,18 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl,
 	if (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN)
 		return rc;
 
+	/*
+	 * TB710FU: backport of 7.4-rc1 a47987366e7f (Oleg Keri).  If the
+	 * retry loop ran out, the last msm_dp_ctrl_reinitialize_mainlink()
