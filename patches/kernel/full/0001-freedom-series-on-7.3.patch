+{
+    struct cts_platform_data *pdata =
+        container_of(work, struct cts_platform_data, ts_irq_work);
+
+    cts_dbg("IRQ work");
+
+    cts_plat_handle_irq(pdata);
+
+    cts_plat_enable_irq(pdata);
+}
