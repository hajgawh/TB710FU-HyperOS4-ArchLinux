+static int cst1xx_init(struct hyn_ts_data* ts_data)
+{
+    int ret = 0;
+    u8 buf[4];
+    HYN_ENTER();
+    hyn_1xxdata = ts_data;
+    ret = cst1xx_enter_boot();
+    if(ret){
+        HYN_ERROR("cst1xx_enter_boot failed");
+        return -1;
+    }
+    hyn_1xxdata->fw_updata_addr = (u8*)fw_bin;
+    hyn_1xxdata->fw_updata_len = CST1XX_BIN_SIZE;
+    hyn_1xxdata->hw_info.ic_fw_checksum = cst1xx_read_checksum();
+    if(hyn_1xxdata->need_updata_fw ==0){
+        hyn_wr_reg(hyn_1xxdata,0xA006EE,3,buf,0); //exit boot
+        cst1xx_rst();
+        mdelay(50);
+        hyn_set_i2c_addr(hyn_1xxdata,MAIN_I2C_ADDR);
+        ret = cst1xx_updata_tpinfo();
+        cst1xx_set_workmode(NOMAL_MODE,0);
+        hyn_1xxdata->need_updata_fw = cst1xx_updata_judge((u8*)fw_bin,CST1XX_BIN_SIZE);
+    }
+    if(hyn_1xxdata->need_updata_fw){
+        HYN_INFO("need updata FW !!!");
+    }
+    return 0;
+}
