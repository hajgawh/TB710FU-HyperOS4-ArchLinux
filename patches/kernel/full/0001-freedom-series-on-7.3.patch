+    struct cts_device *cts_dev = &cts_data->cts_dev;
+
+    return snprintf(buf, PAGE_SIZE, "chipone_cmds.bin size:%zu\n",
+                cts_dev->rtdata.tcscmd_len * sizeof(u16));
