 	}
@@ -4862,25 +4891,36 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 				      enum typec_orientation orientation)
 {
 	struct qmp_combo *qmp = typec_switch_get_drvdata(sw);
-	const struct qmp_phy_cfg *cfg = qmp->cfg;
 
 	if (orientation == qmp->orientation || orientation == TYPEC_ORIENTATION_NONE)
 		return 0;
 
 	mutex_lock(&qmp->phy_mutex);
-	qmp->orientation = orientation;
 
-	if (qmp->init_count) {
-		if (qmp->usb_init_count)
-			qmp_combo_usb_power_off(qmp->usb_phy);
-		qmp_combo_com_exit(qmp, true);
+	/*
+	 * TB710FU: record the new orientation, never rebuild the COM block
+	 * here.
+	 *
+	 * pmic_glink_altmode calls typec_switch_set() before typec_mux_set()
+	 * and before the HPD notification, so a fast re-plug (or a connector
+	 * flip) arrives while the previous DP session may still hold the PHY.
+	 * The old code ran
+	 *     usb_power_off -> com_exit(force) -> com_init(force) -> usb_power_on
+	 * underneath a live DP link: msm_dp keeps power_on/phy_initialized
+	 * set, never runs phy_init() again and therefore never retrains, and
+	 * com_init() programs the block from qmp->qmpphy_mode, which is
+	 * USB3_ONLY right after a detach - the DP PHY is then left held in
+	 * reset and the next register access (teardown or the next plug's
+	 * AUX/training) hangs the bus and resets the SoC.
+	 *
+	 * com_init() programs QPHY_V3_DP_COM_TYPEC_CTRL from qmp->orientation
+	 * and QPHY_V3_DP_COM_PHY_MODE_CTRL from qmp->qmpphy_mode, and it
+	 * always runs on the 0 -> 1 reference transition, i.e. on the first
+	 * phy_init() of the next cable session.  Recording the orientation is
+	 * enough; the hardware follows on the next init.
+	 */
+	qmp->orientation = orientation;
 
-		qmp_combo_com_init(qmp, true);
-		if (qmp->usb_init_count)
-			qmp_combo_usb_power_on(qmp->usb_phy);
-		if (qmp->dp_init_count)
-			cfg->dp_aux_init(qmp);
-	}
 	mutex_unlock(&qmp->phy_mutex);
 
 	return 0;
@@ -4893,6 +4933,58 @@ static void qmp_combo_apply_mode(struct qmp_combo *qmp, enum qmpphy_mode new_mod
 	dev_dbg(qmp->dev, "typec_mux_set: switching from qmpphy mode %d to %d\n",
 		qmp->qmpphy_mode, new_mode);
 
+	/*
+	 * TB710FU: USB3DP and USB3_ONLY both route USB3.  A full COM rebuild
+	 * power-cycles the USB3 PCS; if that lands while the SS hub is
+	 * enumerating, the link dies and the dock's DP output resets too.
+	 * Keep the COM/USB3 state intact for USB3-to-USB3 changes; the DP
+	 * side is configured by its own phy_ops.
+	 */
+	if (qmp->usb_init_count &&
+	    (qmp->qmpphy_mode == QMPPHY_MODE_USB3DP ||
+	     qmp->qmpphy_mode == QMPPHY_MODE_USB3_ONLY) &&
+	    (new_mode == QMPPHY_MODE_USB3DP ||
+	     new_mode == QMPPHY_MODE_USB3_ONLY)) {
+		dev_dbg(qmp->dev,
+			 "TB710FU qmp: keep COM for USB3, mode %d -> %d\n",
+			 qmp->qmpphy_mode, new_mode);
+		qmp->tb_mux_pending = false;
+		qmp->qmpphy_mode = new_mode;
+		/*
+		 * TB710FU: program the COM when entering a DP-capable mode so
+		 * the DP PHY is not left held in reset when com_init() ran
+		 * with USB3_ONLY (USB3 init can precede the mux switch).
+		 *
+		 * Never program the USB3-only direction: clearing DP_MODE
+		 * while the SuperSpeed link is enumerating makes xhci fail
+		 * with "Cannot enable" and latches the dock's SS hub.
+		 */
+		if (new_mode != QMPPHY_MODE_USB3_ONLY &&
+		    qmp->init_count &&
+		    (qmp->com_hw_mode != new_mode ||
+		     qmp->com_hw_orientation != qmp->orientation)) {
+			/*
+			 * Stop the USB3 PCS before re-routing TYPEC_CTRL:
+			 * writing it while the SuperSpeed port is polling
+			 * hangs the bus (flip-while-streaming reset).
+			 */
+			if (qmp->usb_init_count)
+				qmp_combo_usb_power_off(qmp->usb_phy);
+			qmp_combo_com_set_mode(qmp);
+			if (qmp->usb_init_count) {
+				int tb_ret = qmp_combo_usb_power_on(qmp->usb_phy);
+				if (tb_ret)
+					dev_err(qmp->dev,
+						"TB710FU qmp: USB3 restart failed %d\n",
+						tb_ret);
+			}
+		}
+		if (new_mode == QMPPHY_MODE_USB3DP && qmp->dp_init_count)
+			cfg->dp_aux_init(qmp);
+		wake_up_all(&qmp->tb_mode_wq);
+		return;
+	}
+
 	qmp->tb_mux_pending = false;
 	qmp->qmpphy_mode = new_mode;
 
diff --git a/drivers/soc/qcom/pmic_glink_altmode.c b/drivers/soc/qcom/pmic_glink_altmode.c
index 6f092c1c4..6901884d9 100644
--- a/drivers/soc/qcom/pmic_glink_altmode.c
+++ b/drivers/soc/qcom/pmic_glink_altmode.c
@@ -6,6 +6,8 @@
 #include <linux/auxiliary_bus.h>
 #include <linux/bitfield.h>
 #include <linux/cleanup.h>
+#include <linux/devm-helpers.h>
+#include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_device.h>
@@ -20,9 +22,21 @@
 #include <linux/usb/typec_mux.h>
 #include <linux/usb/typec_retimer.h>
 #include <linux/usb/typec_tbt.h>
+#include <linux/workqueue.h>
 
 #include <linux/soc/qcom/pmic_glink.h>
 
+/*
+ * TB710FU: the ADSP reports DP HPD high a few hundred milliseconds after
+ * the Type-C mux was re-routed, while the SuperSpeed/USB2 hub tree is
+ * still enumerating.  Bringing DP up in that window has hard-reset this
+ * platform; delaying only the connect report keeps the two apart.
+ * 0 disables the delay (A/B testing).
+ */
+static unsigned int tb_hpd_delay_ms = 1000;
+module_param(tb_hpd_delay_ms, uint, 0644);
+MODULE_PARM_DESC(tb_hpd_delay_ms, "TB710FU: delay DP connect HPD report (ms, 0=off)");
+
 #define PMIC_GLINK_MAX_PORTS	3
 
 #define USBC_SC8180X_NOTIFY_IND	0x13
@@ -113,6 +127,10 @@ struct pmic_glink_altmode_port {
 
 	struct auxiliary_device *bridge;
 
+	/* TB710FU: deferred DP connect report, see tb_hpd_delay_ms */
+	struct delayed_work hpd_work;
+	bool hpd_notified;
+
 	enum typec_orientation orientation;
 	u16 svid;
 	struct usbc_sc8280x_tbt_data tbt_data;
@@ -138,6 +156,10 @@ struct pmic_glink_altmode {
 
 	struct work_struct enable_work;
 
+	/* Ports without a connector node with a notification to acknowledge */
+	struct work_struct ack_work;
+	unsigned long ack_pending;
+
 	struct pmic_glink_altmode_port ports[PMIC_GLINK_MAX_PORTS];
 };
 
@@ -346,11 +368,87 @@ static void pmic_glink_altmode_safe(struct pmic_glink_altmode *altmode,
 		dev_err(altmode->dev, "failed to setup retimer to USB: %d\n", ret);
 }
 
+/*
+ * The firmware expects every port notification to be acknowledged, also for
+ * ports that have no connector node and are otherwise ignored here; one left
+ * unacknowledged can keep it from reporting further connections. Acknowledge
+ * those from process context, as pmic_glink_altmode_request() sleeps.
+ */
+static void pmic_glink_altmode_ack_worker(struct work_struct *work)
+{
+	struct pmic_glink_altmode *altmode = container_of(work, struct pmic_glink_altmode,
+							  ack_work);
+	unsigned int port;
+
+	for (port = 0; port < BITS_PER_LONG; port++) {
+		if (test_and_clear_bit(port, &altmode->ack_pending))
+			pmic_glink_altmode_request(altmode, ALTMODE_PAN_ACK, port);
+	}
+}
+
+static void pmic_glink_altmode_ack_undefined(struct pmic_glink_altmode *altmode, u8 port)
+{
+	dev_dbg(altmode->dev, "notification on undefined port %d\n", port);
+
+	if (port >= BITS_PER_LONG)
+		return;
+
+	set_bit(port, &altmode->ack_pending);
+	schedule_work(&altmode->ack_work);
+}
+
+static void pmic_glink_altmode_hpd_worker(struct work_struct *work)
+{
+	struct pmic_glink_altmode_port *alt_port =
+		container_of(to_delayed_work(work),
+			     struct pmic_glink_altmode_port, hpd_work);
+
+	/*
+	 * TB710FU: re-check what the firmware reported when the delay was
+	 * armed.  A pseudo detach (USB3DP -> USB3_ONLY) or a real unplug in
+	 * the meantime must not become a connect report: the mux is then
+	 * routed away from DP and msm_dp would program the combo PHY for
+	 * USB3 only.
+	 */
+	if (!READ_ONCE(alt_port->hpd_state) ||
+	    alt_port->svid != USB_TYPEC_DP_SID ||
+	    alt_port->mux_ctrl == MUX_CTRL_STATE_NO_CONN) {
+		dev_dbg(alt_port->altmode->dev,
+			"TB710FU altmode: dropped deferred DP connect\n");
+		return;
+	}
+
+	WRITE_ONCE(alt_port->hpd_notified, true);
+	dev_info(alt_port->altmode->dev,
+		 "TB710FU altmode: deferred DP connect report (%u ms)\n",
+		 tb_hpd_delay_ms);
+	drm_aux_hpd_bridge_notify(&alt_port->bridge->dev,
+				  connector_status_connected);
