+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 6, 0)
+static const struct file_operations cts_manual_ops = {
+    .owner = THIS_MODULE,
+    .open = cts_manual_open,
+    .read = seq_read,
+};
+#else
+static const struct proc_ops cts_manual_ops = {
+    .proc_open = cts_manual_open,
+    .proc_read = seq_read,
+};
+#endif
