+static int peri_set_baudrate(struct hci_uart *hu, unsigned int baudrate)
+{
+	struct qca_data *qca = hu->priv;
+	struct sk_buff *skb;
+	u8 cmd[] = { 0x31, 0x00, 0xF1, 0xFF, 0x02, 0x02, 0x00};
+
