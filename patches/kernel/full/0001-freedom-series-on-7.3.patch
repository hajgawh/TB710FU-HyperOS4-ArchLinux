+/*
+ * Entry-time ADSP doorbells abort suspend-to-RAM unless masked, while
+ * suspend-to-idle depends on servicing them. Late phase, so handlers
+ * never run against noirq-suspended consumers.
+ */
+static int qcom_ipcc_suspend_late(struct device *dev)
+{
+	struct qcom_ipcc *ipcc = dev_get_drvdata(dev);
+
+	if (ipcc->mask_on_s2ram && pm_suspend_target_state == PM_SUSPEND_MEM)
+		disable_irq(ipcc->irq);
+
+	return 0;
+}
+
+static int qcom_ipcc_resume_early(struct device *dev)
+{
+	struct qcom_ipcc *ipcc = dev_get_drvdata(dev);
+
+	if (ipcc->mask_on_s2ram && pm_suspend_target_state == PM_SUSPEND_MEM)
+		enable_irq(ipcc->irq);
+
+	return 0;
+}
+
 static int qcom_ipcc_pm_resume(struct device *dev)
 {
 	struct qcom_ipcc *ipcc = dev_get_drvdata(dev);
@@ -325,6 +354,17 @@ static int qcom_ipcc_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_mbox;
 
+	ipcc->mask_on_s2ram =
+		of_device_is_compatible(pdev->dev.of_node, "qcom,sm8550-ipcc") ||
+		of_device_is_compatible(pdev->dev.of_node, "qcom,sm8750-ipcc");
+
+	/*
+	 * A lazy disable leaves the GIC enable bit set, and a doorbell on the
+	 * still-powered GIC then wakes suspend-to-RAM despite the masking.
+	 */
+	if (ipcc->mask_on_s2ram)
+		irq_set_status_flags(ipcc->irq, IRQ_DISABLE_UNLAZY);
+
 	ret = devm_request_irq(&pdev->dev, ipcc->irq, qcom_ipcc_irq_fn,
 			       IRQF_TRIGGER_HIGH | IRQF_NO_SUSPEND |
 			       IRQF_NO_THREAD, name, ipcc);
@@ -359,6 +399,7 @@ static const struct of_device_id qcom_ipcc_of_match[] = {
 MODULE_DEVICE_TABLE(of, qcom_ipcc_of_match);
 
 static const struct dev_pm_ops qcom_ipcc_dev_pm_ops = {
+	LATE_SYSTEM_SLEEP_PM_OPS(qcom_ipcc_suspend_late, qcom_ipcc_resume_early)
 	NOIRQ_SYSTEM_SLEEP_PM_OPS(NULL, qcom_ipcc_pm_resume)
 };
 
diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
index c1fa42edd..1d6a7f30d 100644
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -165,6 +165,91 @@ static const struct ieee80211_channel ath11k_6ghz_channels[] = {
 	CHAN6G(2, 5935, 0),
 };
 
+extern const char *qcom_serial_number;
+
+/* Define a small struct for storing a 6-byte MAC address array */
+struct macaddr_t {
+	u8 b[ETH_ALEN];
+};
+
+/* Define a static, predefined MAC_ADDR structure */
+static const struct macaddr_t static_macaddr = {
+	.b = { 0x00, 0x03, 0x7F, 0x11, 0x22, 0x33 }
+};
+
+/**
+ * generate_macaddr_from_serial - Generates a MAC_ADDR using the serial number
+ * @macaddr: Pointer to macaddr_t structure to populate
+ *
+ * This function sets the first 3 bytes to 00:03:7F and the last 3 bytes
+ * are derived from the last 6 characters of qcom_serial_number.
+ *
+ * Returns 0 on success, negative error code on failure.
+ */
+static int generate_macaddr_from_serial(struct ath11k *ar, struct macaddr_t *macaddr)
+{
+	size_t serial_len;
+	const char *serial = qcom_serial_number;
+	char last6[7] = {0}; // 6 characters + null terminator
+	int i;
+	int ret;
+
+	if (!serial) {
+		ath11k_err(ar->ab, "qcom_serial_number is NULL");
+		return -EINVAL;
+	}
+
+	serial_len = strlen(serial);
+	if (serial_len < 6) {
+		ath11k_err(ar->ab, "qcom_serial_number is too short: %zu characters", serial_len);
+		return -EINVAL;
+	}
+
+	// Extract the last 6 characters
+	memcpy(last6, serial + serial_len - 6, 6);
+
+	// Initialize the first 3 bytes
+	macaddr->b[5] = 0x00;
+	macaddr->b[4] = 0x03;
+	macaddr->b[3] = 0x7F;
+
+	// Convert the last 6 characters into 3 bytes
+	for (i = 0; i < 3; i++) {
+		char byte_str[3] = {0};
+		u8 byte_val;
+
+		byte_str[0] = last6[i * 2];
+		byte_str[1] = last6[i * 2 + 1];
+
+		if (!isxdigit(byte_str[0]) || !isxdigit(byte_str[1])) {
+			ath11k_err(ar->ab, "Invalid hex characters in serial number: %c%c",
+					   byte_str[0], byte_str[1]);
+			return -EINVAL;
+		}
+
+		ret = kstrtou8(byte_str, 16, &byte_val);
+		if (ret < 0) {
+			ath11k_err(ar->ab, "Failed to convert hex string to u8: %c%c",
+					   byte_str[0], byte_str[1]);
+			return ret;
+		}
+
+		macaddr->b[2 - i] = byte_val; // Assign to bytes 2,1,0
+	}
+
+	ath11k_info(ar->ab, "Generated MAC_ADDR: %pMR", macaddr);
+
+	return 0;
+}
+
+static void ath11k_reverse_mac(u8 *dst, const u8 *src)
+{
+	int i;
+
+	for (i = 0; i < ETH_ALEN; i++)
+		dst[i] = src[ETH_ALEN - 1 - i];
+}
+
 static struct ieee80211_rate ath11k_legacy_rates[] = {
 	{ .bitrate = 10,
 	  .hw_value = ATH11K_HW_RATE_CCK_LP_1M },
@@ -10709,6 +10794,7 @@ int ath11k_mac_register(struct ath11k_base *ab)
 	int i;
 	int ret;
 	u8 mac_addr[ETH_ALEN] = {};
+	struct macaddr_t generated_macaddr;
 
 	if (test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags))
 		return 0;
@@ -10726,6 +10812,10 @@ int ath11k_mac_register(struct ath11k_base *ab)
 	for (i = 0; i < ab->num_radios; i++) {
 		pdev = &ab->pdevs[i];
 		ar = pdev->ar;
+
+		ret = generate_macaddr_from_serial(ar, &generated_macaddr);
+		if (ret) {
+			ath11k_err(ab, "Failed to generate MAC_ADDR from serial number, falling back");
 		if (ab->pdevs_macaddr_valid) {
 			ether_addr_copy(ar->mac_addr, pdev->mac_addr);
 		} else {
@@ -10733,7 +10823,12 @@ int ath11k_mac_register(struct ath11k_base *ab)
 				ether_addr_copy(ar->mac_addr, ab->mac_addr);
 			else
 				ether_addr_copy(ar->mac_addr, mac_addr);
-			ar->mac_addr[4] += i;
+			ar->mac_addr[4] += i; /* adjust offset per radio */
+			}
+		} else {
+			/* If successful, use the newly generated MAC address. */
+			ath11k_reverse_mac(ar->mac_addr, generated_macaddr.b);
+			ath11k_info(ab, "MAC_ADDR set to %pMR", generated_macaddr.b);
 		}
 
 		idr_init(&ar->txmgmt_idr);
