+		drive-strength = <16>;
+		output-low;
+		bias-pull-up;
+	};
+
+	dsi_p_rst_active: dsi-p-rst-active-state {
+		pins = "gpio75";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	dsi_p_rst_suspend: dsi-p-rst-suspend-state {
+		pins = "gpio75";
+		function = "gpio";
+		drive-strength = <2>;
