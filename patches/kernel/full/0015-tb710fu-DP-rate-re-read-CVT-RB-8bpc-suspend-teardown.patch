@@ -59,6 +59,15 @@ struct dpu_hw_intf_cfg {
 	unsigned int dsc;
 };
 
+/*
+ * SSPP_CURSOR0/1 flush bits in CTL_FLUSH. The hardware may leave a cursor
+ * flush bit pending when the cursor SSPP is not scheduled into the active
+ * composition (e.g. after a commit that disables the cursor plane); it only
+ * clears once the cursor SSPP is scheduled again. Commit-done must not gate
+ * on them, or every following commit stalls for the full wait timeout.
+ */
+#define DPU_HW_CURSOR_FLUSH_MASK (BIT(22) | BIT(23))
+
