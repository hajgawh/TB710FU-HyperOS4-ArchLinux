new file mode 100644
index 000000000..430c01f00
--- /dev/null
+++ b/drivers/input/touchscreen/chipone_tddi/cts_tool.c
@@ -0,0 +1,1214 @@
+#define LOG_TAG         "Tool"
+
+#include "cts_config.h"
+#include "cts_platform.h"
+#include "cts_core.h"
+#include "cts_firmware.h"
+#include "cts_test.h"
+#include "cts_tcs.h"
+
+#ifdef CONFIG_CTS_LEGACY_TOOL
+
+#define CTS_TOOL_IOCTL_TCS_RW_BUF_MAX_SIZ     1024
+#define CTS_TOOL_IOCTL_TCS_RW_OPFLAG_READ     1
+#define CTS_TOOL_IOCTL_TCS_RW_OPFLAG_WRITE    2
+
+#pragma pack(1)
+/** Tool command structure */
+struct cts_tool_cmd {
+    u8 cmd;
+    u8 flag;
+    u8 circle;
+    u8 times;
+    u8 retry;
+    u32 data_len;
+    u8 addr_len;
+    u8 addr[4];
+    u8 tcs[2];
