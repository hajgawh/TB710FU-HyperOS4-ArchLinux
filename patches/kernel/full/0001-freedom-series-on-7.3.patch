+		dpu_enc->idle_refresh_base_vt = mode->vtotal;
+		WRITE_ONCE(dpu_enc->idle_refresh_live_vt, mode->vtotal);
+		dpu_enc->idle_refresh_last_kick = jiffies;
+	}
