From 09163997774fe390b08733c1e48b2c16c6532026 Mon Sep 17 00:00:00 2001
From: tb710fu <tb710fu@localhost>
Date: Tue, 27 Oct 2026 09:57:04 +0000
Subject: [PATCH 10/27] tb710fu 7.3: describe the 6-core 1+2+2+1 topology

---
 .../boot/dts/qcom/sm8650-lenovo-tb710fu.dts   | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
index 9c0face6c..3dd1115c1 100644
--- a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
@@ -1250,3 +1250,69 @@
 &xo_board {
 	clock-frequency = <76800000>;
 };
+
+/*
+ * TB710FU: this SKU only exposes six cores, laid out as 1+2+2+1.
+ * MPIDR 0x100 and 0x200 are fused off and PSCI returns
+ * INVALID_PARAMETERS for them, so the generic sm8650.dtsi 8-core
+ * description must not map those nodes.  status = "fail" (not
+ * "disabled") is required here: arm64's of_get_next_cpu_node()
+ * skips only "fail"/"fail-*" nodes, while "disabled" nodes would
+ * still receive logical CPU numbers and be probed.
+ *
+ * Logical numbering after this override:
+ *   0: cpu@0    (A520, MPIDR 0x0,   freq domain 0)
+ *   1: cpu@300  (A720, MPIDR 0x300, freq domain 3)
+ *   2: cpu@400  (A720, MPIDR 0x400, freq domain 3)
+ *   3: cpu@500  (A720, MPIDR 0x500, freq domain 1)
+ *   4: cpu@600  (A720, MPIDR 0x600, freq domain 1)
+ *   5: cpu@700  (X4,   MPIDR 0x700, freq domain 2)
+ *
+ * The resulting cpufreq policies are policy0/1/3/5, exactly the set
+ * used by Lenovo's init.kernel.post_boot-pineapple_1_2_2_1.sh.
+ */
+&cpu1 {
+	status = "fail";
+};
+
+&cpu2 {
+	status = "fail";
+};
+
+&{/cpus} {
+	/delete-node/ cpu-map;
+
+	cpu-map {
+		cluster0 {
+			core0 {
+				cpu = <&cpu0>;
+			};
+		};
+
+		cluster1 {
+			core0 {
+				cpu = <&cpu3>;
+			};
+
+			core1 {
+				cpu = <&cpu4>;
+			};
+		};
+
+		cluster2 {
+			core0 {
+				cpu = <&cpu5>;
+			};
+
+			core1 {
+				cpu = <&cpu6>;
+			};
+		};
+
+		cluster3 {
+			core0 {
+				cpu = <&cpu7>;
+			};
+		};
+	};
+};
