@@ -97,6 +100,52 @@ static int _dpu_danger_signal_status(struct seq_file *s,
 	return 0;
 }
 
+static int dpu_debugfs_lutdma_show(struct seq_file *s, void *v)
+{
+	struct dpu_kms *dpu_kms = s->private;
+	int i, ret;
+
+	if (!dpu_kms->reg_dma) {
+		seq_puts(s, "no engine\n");
+		return 0;
+	}
+
+	ret = pm_runtime_resume_and_get(&dpu_kms->pdev->dev);
+	if (ret)
+		return ret;
+	dpu_reg_dma_debugfs_show(dpu_kms->reg_dma, s);
+	for (i = 0; i < ARRAY_SIZE(dpu_kms->rm.dspp_blks); i++) {
+		struct dpu_hw_dspp *dspp;
+		u32 base;
+
+		if (!dpu_kms->rm.dspp_blks[i])
+			continue;
