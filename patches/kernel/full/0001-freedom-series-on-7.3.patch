+    remaining = size;
+    for (i = 0; i < size && count <= PAGE_SIZE; i += PRINT_ROW_SIZE) {
+        size_t linelen = min((size_t)remaining, (size_t)PRINT_ROW_SIZE);
+
+        remaining -= PRINT_ROW_SIZE;
+
+        count += snprintf(buf + count, PAGE_SIZE - count, "%04x: ", addr);
