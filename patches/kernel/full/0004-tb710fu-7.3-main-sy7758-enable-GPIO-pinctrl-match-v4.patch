From c7964263cc606744d7efe9319e26cb7fb5e36bf3 Mon Sep 17 00:00:00 2001
From: tb <tb@local>
Date: Tue, 27 Oct 2026 04:12:26 +0000
Subject: [PATCH 04/27] tb710fu 7.3: main sy7758 enable GPIO + pinctrl (match
 v4 DTB)

---
 arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
index dacbd8cc0..9c0face6c 100644
--- a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
@@ -709,6 +709,10 @@
 		compatible = "silergy,sy7758";
 		reg = <0x2e>;
 		vdd-supply = <&sy7758_vdd>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&sy7758_pwr_active>;
+		pinctrl-1 = <&sy7758_pwr_sleep>;
+		enable-gpios = <&tlmm 89 GPIO_ACTIVE_HIGH>;
 	};
 
 };
