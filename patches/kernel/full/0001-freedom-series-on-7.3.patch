+		break;
+	case DPU_DSPP_GAMUT:
+		ctx->pending_dspp_flush_mask[dspp - DSPP_0] |= BIT(3);
+		break;
+	case DPU_DSPP_SB:
+		ctx->pending_dspp_flush_mask[dspp - DSPP_0] |= BIT(31);
