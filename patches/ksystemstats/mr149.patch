+void MsmGpuTest::testInvalidFdInfo()
+{
+    QFETCH(QByteArray, data);
+
+    QBuffer buffer(&data);
+    QVERIFY(buffer.open(QIODevice::ReadOnly));
+    QVERIFY(!linuxMsmClientSample(parseLinuxDrmFdInfo(&buffer)).has_value());
+}
