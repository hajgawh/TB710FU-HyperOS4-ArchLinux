+static void release_all_finger(struct hyn_ts_data *ts_data)
+{
+    HYN_ENTER();
+#if HYN_MT_PROTOCOL_B_EN
+    {
+    u8 i;
+	for(i=0; i< ts_data->plat_data.max_touch_num; i++) {	
