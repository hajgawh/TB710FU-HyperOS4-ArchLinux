diff --git a/drivers/input/touchscreen/chipone_tddi/cts_core.c b/drivers/input/touchscreen/chipone_tddi/cts_core.c
new file mode 100644
index 000000000..02aa96a0e
--- /dev/null
+++ b/drivers/input/touchscreen/chipone_tddi/cts_core.c
@@ -0,0 +1,2908 @@
+#define LOG_TAG         "Core"
+
+#include "cts_config.h"
+#include "cts_platform.h"
+#include "cts_core.h"
+#include "cts_sfctrl.h"
+#include "cts_spi_flash.h"
