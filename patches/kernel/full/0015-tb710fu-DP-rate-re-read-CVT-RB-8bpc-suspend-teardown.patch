+/*
+ * TB710FU: every physical re-plug makes the firmware announce more than one
+ * alt-mode state within ~1 s (DP -> USB -> DP, each step power-cycling the
+ * shared QMP COM block).  If that lands while the DP PHY is starting up,
+ * phy_configure()/phy_power_on() still return 0 but the DP PLL never locks:
+ * dispcc then reports "disp_cc_mdss_dptx0_link_clk status stuck at 'off'"
+ * and msm_dp_ctrl_on_link() fails with -16.  A single such failure used to
+ * be logged and ignored, which left the DPU video encoder enabled and
+ * waiting for a vblank that never arrives (thousands of "vblank timeout",
+ * recoverable only by reboot).  Retry with a full teardown: phy_exit() and
+ * phy_init() are what give the next attempt a clean
+ * phy_init -> phy_configure -> phy_power_on run, which re-programs the PHY
+ * for the settled orientation/lane assignment.
+ */
+static unsigned int link_retries = 5;
+module_param(link_retries, uint, 0644);
+MODULE_PARM_DESC(link_retries, "TB710FU: attempts to bring the DP link up");
+
+static unsigned int link_retry_ms = 200;
+module_param(link_retry_ms, uint, 0644);
+MODULE_PARM_DESC(link_retry_ms, "TB710FU: delay between link bring-up attempts");
+
+/*
+ * TB710FU: total AUX budget for one link bring-up (0 disables the guard).
+ * A dead AUX PHY used to turn every DPCD message into 32 x 250 ms of
+ * retries and wedge the atomic commit thread past the PMIC watchdog.
+ */
+static unsigned int tb_link_budget_ms = 3000;
+module_param(tb_link_budget_ms, uint, 0644);
+MODULE_PARM_DESC(tb_link_budget_ms, "TB710FU: AUX budget for one link bring-up (ms)");
+
+static int msm_dp_display_on_link(struct msm_dp_display_private *dp)
+{
+	unsigned int tries = link_retries ? link_retries : 1;
+	unsigned int attempt;
+	int rc;
+
+	for (attempt = 0; attempt < tries; attempt++) {
+		/* Wake the sink before (re)training: after a DPMS off it may sit
+		 * in DPCD D3 and only leaves it on a SET_POWER transition.  This
+		 * must run after the PHY is up. */
+		msm_dp_link_psm_config(dp->link, &dp->panel->link_info, false);
+
+		rc = msm_dp_ctrl_on_link(dp->ctrl, dp->panel);
+		if (!rc)
+			return 0;
+
+		if (attempt == tries - 1)
+			break;
+
+		DRM_INFO("TB710FU: link bring-up failed rc=%d, retrying %u/%u\n",
+			  rc, attempt + 1, tries - 1);
+
+		msm_dp_ctrl_off_link(dp->ctrl, dp->panel);
+		msm_dp_display_host_phy_exit(dp);
+
+		msleep(link_retry_ms);
+
+		msm_dp_display_host_phy_init(dp);
+		if (!dp->phy_initialized)
+			break;
+	}
+
+	/* Leave the PHY off so the next enable starts from a clean init. */
+	msm_dp_ctrl_off_link(dp->ctrl, dp->panel);
+	msm_dp_display_host_phy_exit(dp);
+
+	return rc;
+}
+
 static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 {
 	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
@@ -644,18 +717,32 @@ static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 		return -ENOTCONN;
 
 	if (!msm_dp_display->power_on) {
+		/*
+		 * The plug handler may have initialised the PHY already; the
+		 * flag, not the return value, is what matters here.  The flag
+		 * is cleared on system suspend (see msm_dp_pm_runtime_suspend),
+		 * so this really runs phy_init() on the resume path.
+		 */
 		msm_dp_display_host_phy_init(dp);
+		if (!dp->phy_initialized) {
+			/* never power on a PHY that failed to init */
+			pm_runtime_put_sync(&msm_dp_display->pdev->dev);
+			return -EIO;
+		}
 		force_link_train = true;
 	}
 
-	rc = msm_dp_ctrl_on_link(dp->ctrl, dp->panel);
+	msm_dp_aux_set_budget(dp->aux, tb_link_budget_ms);
+	rc = msm_dp_display_on_link(dp);
+	msm_dp_aux_set_budget(dp->aux, 0);
 	if (rc) {
 		DRM_ERROR("Failed link training (rc=%d)\n", rc);
 		// TODO: schedule drm_connector_set_link_status_property()
 		return rc;
 	}
 
-	return msm_dp_ctrl_prepare_stream_on(dp->ctrl, dp->panel, force_link_train);
+	rc = msm_dp_ctrl_prepare_stream_on(dp->ctrl, dp->panel, force_link_train);
+	return rc;
 }
 
 static int msm_dp_display_enable(struct msm_dp_display_private *dp,
@@ -716,29 +803,95 @@ static void msm_dp_display_audio_notify_disable(struct msm_dp_display_private *d
 	msm_dp_display->audio_enabled = false;
 }
 
+/*
+ * TB710FU: the A27U deasserts HPD 1-2 min after the link disappears and only
+ * a physical re-plug brings it back, so on DPMS off we keep the main link and
+ * the PHY alive while the sink stays attached.
+ *
+ * We must still put the sink itself into D3: leaving it in D0 with the link up
+ * but no video stream keeps the monitor half-awake, and it re-shows its
+ * "no signal / entering standby" OSD every ~27 s (measured 2026-11-06).
+ *
+ * This is only valid while the sink is really attached: link->sink_count is
+ * stale on HPD unplug (it is refreshed when the caps are read on the next
+ * connect), so dp->plugged is the "the cable is gone" signal.
+ *
+ * keep_link=1 keeps the link/PHY up on DPMS off and only puts the sink into
+ * D3; measured 2026-11-06 that is NOT enough for the A27U: as long as the
+ * DPTX keeps driving the main link, the monitor keeps waking up and re-shows
+ * its "no signal / entering standby" OSD, even though the sink itself is in
+ * D3.  Only a full teardown (link clocks off + phy_exit) makes it stay quiet,
+ * so that is the default now; tb-dp-wake-fix renegotiates the alt mode on
+ * wake if the monitor dropped HPD in the meantime.
+ */
+static bool keep_link;
+module_param(keep_link, bool, 0644);
+MODULE_PARM_DESC(keep_link, "TB710FU: keep DP link/PHY alive on DPMS off (A/B; A27U keeps waking up)");
+
 static int msm_dp_display_disable(struct msm_dp_display_private *dp,
 				  struct msm_dp_panel *msm_dp_panel)
 {
 	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
+	bool sink_attached = dp->plugged && dp->link->sink_count > 0;
 
-	if (!msm_dp_display->power_on)
+	if (!msm_dp_display->power_on) {
+		if (dp->phy_initialized && (!sink_attached || !keep_link)) {
+			if (sink_attached)
+				msm_dp_link_psm_config(dp->link,
+						       &msm_dp_panel->link_info,
+						       true);
+			if (msm_dp_ctrl_link_clks_on(dp->ctrl))
+				msm_dp_ctrl_off_link(dp->ctrl, msm_dp_panel);
+			msm_dp_display_host_phy_exit(dp);
+		}
 		return 0;
+	}
 
 	msm_dp_panel_disable_vsc_sdp(msm_dp_panel);
 
 	msm_dp_ctrl_off_pixel_clk(dp->ctrl);
 
-	/* dongle is still connected but sinks are disconnected */
-	if (dp->link->sink_count == 0)
+	if (!sink_attached) {
+		/*
+		 * Cable is gone: there is no AUX partner left to talk to, so skip
+		 * the DPCD D3 write and tear the link down locally.
+		 *
+		 * Use phy_exit() here, NOT msm_dp_ctrl_reinit_phy(): a back-to-back
+		 * exit+init leaves the combo PHY such that the DP PLL never starts
+		 * on the next enable and dispcc reports
+		 * "disp_cc_mdss_dptx0_link_clk status stuck at 'off'" (-16).
+		 * Exiting now lets the next connect run a fresh
+		 * phy_init() -> phy_configure() -> phy_power_on() cycle.
