+
+&tlmm {
+	mcu_key_pins: mcu-key-pins-state {
+		key-pins {
+			pins = "gpio4", "gpio15", "gpio83", "gpio84";
+			function = "gpio";
+			drive-strength = <4>;
+			bias-pull-up;
+		};
+
+		irq-pins {
+			pins = "gpio63", "gpio64";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		ctrl-pins {
+			pins = "gpio42", "gpio43", "gpio48", "gpio50", "gpio72";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	rocker_key_pins: rocker-key-pins-state {
+		pins = "gpio111", "gpio118";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-pull-up;
+	};
+
+	bt_en_state: bt-default-state {
