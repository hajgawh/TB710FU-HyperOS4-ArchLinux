+&sound {
+	compatible = "qcom,sm8250-sndcard";
+	model = "AYN Thor Lite";
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&tert_mi2s_active>;
+
+	clocks = <&q6afecc LPASS_CLK_ID_TER_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	clock-names = "i2s_clk";
+
+	assigned-clocks = <&q6afecc LPASS_CLK_ID_TER_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	assigned-clock-rates = <1536000>;
+
+	/*
+	 * Speaker output goes through TERTIARY MI2S to the two AW88166
+	 * amps on I2C9 (the chip-level "SpkrLeft"/"SpkrRight" routing
+	 * lives inside the codec driver via sound-name-prefix).
+	 *
+	 * For capture, only AMIC2 is wired on this board: it feeds the
+	 * 3.5 mm headset mic and (when no headset is plugged) the built-in
+	 * mic, going through MIC BIAS2 -> WCD ADC2 -> TX SoundWire ADC1
+	 * port -> tx-macro. The Android DTS lists DMIC paths too, but
+	 * cdc_dmic{01,23,45}_pinctrl are all status="disabled" there,
+	 * so this board has no on-board digital mics. AMIC1/3/4/5 and
+	 * IN3_AUX similarly aren't wired up.
+	 *
+	 * Headphone output uses HPHL/HPHR; the AUX_OUT path is left out
+	 * because there's no second analog output on this device.
+	 */
+	audio-routing =
+		"IN1_HPHL", "HPHL_OUT",
+		"IN2_HPHR", "HPHR_OUT",
+		"AMIC2", "MIC BIAS2",
+		"TX SWR_ADC1", "ADC2_OUTPUT",
+	    "SpkrLeft AIF_RX", "TERT_MI2S_RX",
+	    "SpkrRight AIF_RX", "TERT_MI2S_RX";
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+		cpu {
+			sound-dai = <&q6asmdai  MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+		cpu {
+			sound-dai = <&q6asmdai  MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		};
+	};
+
+	mm3-dai-link {
+		link-name = "MultiMedia3";
+		cpu {
+			sound-dai = <&q6asmdai  MSM_FRONTEND_DAI_MULTIMEDIA3>;
+		};
+	};
+
+	wcd-playback-dai-link {
+		link-name = "WCD Playback";
+		cpu {
+			sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+		};
+		codec {
+			sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
+	speaker-dai-link {
+		link-name = "Tertiary MI2S Playback";
+		cpu {
+			sound-dai = <&q6afedai TERTIARY_MI2S_RX>;
+		};
+		codec {
+			sound-dai = <&spk_amp_l>, <&spk_amp_r>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
+	wcd-capture-dai-link {
+		link-name = "WCD Capture";
+		cpu {
+			sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+		};
+
+		codec {
+			sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+};
