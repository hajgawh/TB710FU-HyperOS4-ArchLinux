#!/bin/bash
# TB710FU: turn the external DP output off before unplugging the cable.
#
# Any cable disconnect/reconnect while DP is actively scanning out hard-resets
# this platform (Type-C mux/ADSP level, not the DP driver).  With the output
# disabled -- even though the link and PHY stay up -- unplugging is safe.
set -eu

export XDG_RUNTIME_DIR=/run/user/1001
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus

wl=$(ls "$XDG_RUNTIME_DIR" 2>/dev/null | grep -m1 '^wayland-') || true
if [ -z "${wl:-}" ]; then
	echo "no wayland session found in $XDG_RUNTIME_DIR" >&2
	exit 1
fi

[ "$(cat /sys/class/drm/card1-DP-1/status 2>/dev/null)" = "connected" ] || {
	echo "DP-1 not connected, nothing to do"
	exit 0
}

WAYLAND_DISPLAY="$wl" kscreen-doctor output.DP-1.disable
sleep 1

if [ "$(cat /sys/class/drm/card1-DP-1/enabled 2>/dev/null)" = "disabled" ]; then
	echo "DP-1 disabled - safe to unplug"
else
	echo "DP-1 still enabled, check kscreen-doctor -o" >&2
	exit 1
fi
