+        if (oem_data->type##_test_data) { \
+            cts_info("- Free " #type " test data mem"); \
+            kfree(oem_data->type##_test_data); \
+            oem_data->type##_test_data = NULL; \
+            oem_data->type##_test_data_buff_size = 0; \
+        } \
+    } while(0)
