+        /* Lower version kernel return void */
+        hex_dump_to_buffer(data + i, linelen, PRINT_ROW_SIZE, 1,
+            buf + count, PAGE_SIZE - count, true);
+        count += strlen(buf + count);
+
+        if (count < PAGE_SIZE) {
+            buf[count++] = '\n';
+            addr += PRINT_ROW_SIZE;
+        } else {
