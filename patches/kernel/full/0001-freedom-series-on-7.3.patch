+		return BLEND_3D_NONE;
+
+	for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_mixer); i++) {
+		if (!dpu_enc->hw_mixer[i])
+			break;
+		num_mixers++;
+	}
