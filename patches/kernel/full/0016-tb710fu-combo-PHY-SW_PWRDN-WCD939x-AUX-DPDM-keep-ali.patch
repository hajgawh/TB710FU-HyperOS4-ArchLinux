-	return ret;
 }
 
 static int qmp_combo_usb_power_off(struct phy *phy)
@@ -4290,11 +4331,33 @@ static int qmp_combo_usb_power_off(struct phy *phy)
 	return 0;
 }
 
+/*
+ * TB710FU: block until the Type-C mux has routed the combo PHY to USB3 (or
+ * until USB3DP).  Initializing the USB3 core while the block is still muxed
+ * to DP makes xhci fail with -110 and leaves the PHY in a state that wedges
+ * the bus on the next DP bring-up.
+ */
+static void qmp_combo_tb_wait_usb3(struct qmp_combo *qmp)
+{
+	if (READ_ONCE(qmp->qmpphy_mode) != QMPPHY_MODE_DP_ONLY)
+		return;
+
+	pr_info("TB710FU qmp: USB3 init waiting for mux (mode=%d)\n",
+		qmp->qmpphy_mode);
+	wait_event_timeout(qmp->tb_mode_wq,
+		READ_ONCE(qmp->qmpphy_mode) != QMPPHY_MODE_DP_ONLY,
+		msecs_to_jiffies(1000));
+	pr_info("TB710FU qmp: USB3 init proceeding (mode=%d)\n",
+		qmp->qmpphy_mode);
+}
+
 static int qmp_combo_usb_init(struct phy *phy)
 {
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
 	int ret;
 
+	qmp_combo_tb_wait_usb3(qmp);
+
 	mutex_lock(&qmp->phy_mutex);
 	ret = qmp_combo_com_init(qmp, false);
 	if (ret)
@@ -4801,10 +4864,65 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 	return 0;
 }
 
+static void qmp_combo_apply_mode(struct qmp_combo *qmp, enum qmpphy_mode new_mode)
+{
+	const struct qmp_phy_cfg *cfg = qmp->cfg;
+
+	dev_dbg(qmp->dev, "typec_mux_set: switching from qmpphy mode %d to %d\n",
+		qmp->qmpphy_mode, new_mode);
+
+	qmp->tb_mux_pending = false;
+	qmp->qmpphy_mode = new_mode;
+
+	if (qmp->init_count) {
+		if (qmp->usb_init_count)
+			qmp_combo_usb_power_off(qmp->usb_phy);
+
+		if (qmp->dp_init_count)
+			writel(DP_PHY_PD_CTL_PSR_PWRDN, qmp->dp_dp_phy + QSERDES_DP_PHY_PD_CTL);
+
+		qmp_combo_com_exit(qmp, true);
+
+		/* Now everything's powered down, power up the right PHYs */
+		qmp_combo_com_init(qmp, true);
+
+		if (new_mode == QMPPHY_MODE_DP_ONLY) {
+			if (qmp->usb_init_count)
+				qmp->usb_init_count--;
+		}
+
+		if (new_mode == QMPPHY_MODE_USB3DP || new_mode == QMPPHY_MODE_USB3_ONLY) {
+			qmp_combo_usb_power_on(qmp->usb_phy);
+			if (!qmp->usb_init_count)
+				qmp->usb_init_count++;
+		}
+
+		if (new_mode == QMPPHY_MODE_DP_ONLY || new_mode == QMPPHY_MODE_USB3DP) {
+			if (qmp->dp_init_count)
+				cfg->dp_aux_init(qmp);
+		}
+	}
+
+	wake_up_all(&qmp->tb_mode_wq);
+}
+
+static void qmp_combo_tb_mux_work(struct work_struct *work)
+{
+	struct qmp_combo *qmp = container_of(work, struct qmp_combo, tb_mux_work);
+
+	guard(mutex)(&qmp->phy_mutex);
+
+	if (!qmp->tb_mux_pending || qmp->dp_init_count)
+		return;
+
+	qmp->tb_mux_pending = false;
+	if (qmp->tb_pending_mode != qmp->qmpphy_mode)
+		qmp_combo_apply_mode(qmp, qmp->tb_pending_mode);
+}
