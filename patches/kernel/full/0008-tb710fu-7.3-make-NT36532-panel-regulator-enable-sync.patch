From b73ae2f786079a43e19bed3f4b6cb63ef90141b6 Mon Sep 17 00:00:00 2001
From: tb <tb@local>
Date: Tue, 27 Oct 2026 07:02:41 +0000
Subject: [PATCH 08/27] tb710fu 7.3: make NT36532 panel regulator enable
 synchronous and NULL-safe

---
 .../panel/panel-nt36532-wqhd-dual-dsi-dsc.c   | 53 +++++++++++++++++--
 drivers/regulator/core.c                      | 20 +++++++
 2 files changed, 70 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-nt36532-wqhd-dual-dsi-dsc.c b/drivers/gpu/drm/panel/panel-nt36532-wqhd-dual-dsi-dsc.c
index b41b8f6b2..c5e239fd4 100644
--- a/drivers/gpu/drm/panel/panel-nt36532-wqhd-dual-dsi-dsc.c
+++ b/drivers/gpu/drm/panel/panel-nt36532-wqhd-dual-dsi-dsc.c
@@ -249,12 +249,56 @@ static void nt36532_reset(struct panel_info *pinfo)
 	usleep_range(10000, 11000);
 }
 
+static int nt36532_enable_supplies(struct panel_info *pinfo)
+{
+	int i, ret;
+
+	/*
+	 * A supplier (e.g. the backlight) can force-unbind this panel through a
+	 * managed device link.  Its devres cleanup then clears the consumers in
+	 * this array while the DRM panel can still be referenced.  Never hand a
+	 * NULL consumer to the async regulator bulk-enable path.
+	 */
+	for (i = 0; i < ARRAY_SIZE(pinfo->supplies); i++) {
+		if (!pinfo->supplies[i].consumer) {
+			dev_err(pinfo->panel.dev,
+				"supply %s consumer is NULL (stale panel?)\n",
+				pinfo->supplies[i].supply);
+			return -EINVAL;
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(pinfo->supplies); i++) {
+		ret = regulator_enable(pinfo->supplies[i].consumer);
+		if (ret) {
+			dev_err(pinfo->panel.dev, "failed to enable %s: %d\n",
+				pinfo->supplies[i].supply, ret);
+			while (--i >= 0)
+				regulator_disable(pinfo->supplies[i].consumer);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static void nt36532_disable_supplies(struct panel_info *pinfo)
+{
+	int i;
+
+	for (i = ARRAY_SIZE(pinfo->supplies) - 1; i >= 0; i--) {
+		if (!pinfo->supplies[i].consumer)
+			continue;
+		regulator_disable(pinfo->supplies[i].consumer);
+	}
+}
+
 static int nt36532_prepare(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
 	int ret;
 
-	ret = regulator_bulk_enable(ARRAY_SIZE(pinfo->supplies), pinfo->supplies);
+	ret = nt36532_enable_supplies(pinfo);
 	if (ret < 0) {
 		dev_err(panel->dev, "failed to enable regulators: %d\n", ret);
 		return ret;
@@ -264,7 +308,7 @@ static int nt36532_prepare(struct drm_panel *panel)
 
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
-		regulator_bulk_disable(ARRAY_SIZE(pinfo->supplies), pinfo->supplies);
+		nt36532_disable_supplies(pinfo);
 		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
 		return ret;
 	}
@@ -291,13 +335,14 @@ static int nt36532_unprepare(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
-	regulator_bulk_disable(ARRAY_SIZE(pinfo->supplies), pinfo->supplies);
+	nt36532_disable_supplies(pinfo);
 
 	return 0;
 }
 
 static void nt36532_remove(struct mipi_dsi_device *dsi)
 {
+	dev_info(&dsi->dev, "nt36532 panel removed\n");
 	/* devm_drm_panel_alloc 托管生命周期，无需 drm_panel_remove */
 }
 
@@ -443,6 +488,8 @@ static int nt36532_probe(struct mipi_dsi_device *dsi)
 			return dev_err_probe(dev, ret, "cannot attach to DSI%d host.\n", i);
 	}
 
+	dev_info(dev, "nt36532 panel probed\n");
+
 	return 0;
 }
 
diff --git a/drivers/regulator/core.c b/drivers/regulator/core.c
index 0836ec324..63dd1b7e5 100644
--- a/drivers/regulator/core.c
+++ b/drivers/regulator/core.c
@@ -5399,6 +5399,11 @@ static void regulator_bulk_enable_async(void *data, async_cookie_t cookie)
 {
 	struct regulator_bulk_data *bulk = data;
 
+	if (!bulk->consumer) {
+		bulk->ret = -EINVAL;
+		return;
+	}
+
 	bulk->ret = regulator_enable(bulk->consumer);
 }
 
@@ -5422,6 +5427,14 @@ int regulator_bulk_enable(int num_consumers,
 	int i;
 	int ret = 0;
 
+	for (i = 0; i < num_consumers; i++) {
+		if (!consumers[i].consumer) {
+			pr_err("Failed to enable %s: no consumer\n",
+			       consumers[i].supply ? consumers[i].supply : "unknown");
+			return -EINVAL;
+		}
+	}
+
 	for (i = 0; i < num_consumers; i++) {
 		async_schedule_domain(regulator_bulk_enable_async,
 				      &consumers[i], &async_domain);
@@ -5472,6 +5485,11 @@ int regulator_bulk_disable(int num_consumers,
 	int ret, r;
 
 	for (i = num_consumers - 1; i >= 0; --i) {
+		if (!consumers[i].consumer) {
+			pr_err("Failed to disable %s: no consumer\n",
+			       consumers[i].supply ? consumers[i].supply : "unknown");
+			continue;
+		}
 		ret = regulator_disable(consumers[i].consumer);
 		if (ret != 0)
 			goto err;
@@ -5482,6 +5500,8 @@ int regulator_bulk_disable(int num_consumers,
 err:
 	pr_err("Failed to disable %s: %pe\n", consumers[i].supply, ERR_PTR(ret));
 	for (++i; i < num_consumers; ++i) {
+		if (!consumers[i].consumer)
+			continue;
 		r = regulator_enable(consumers[i].consumer);
 		if (r != 0)
 			pr_err("Failed to re-enable %s: %pe\n",
