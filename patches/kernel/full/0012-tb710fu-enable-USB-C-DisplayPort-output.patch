From a43f4de57b2155966120bacc685d49751723f12a Mon Sep 17 00:00:00 2001
From: tb <tb@local>
Date: Tue, 3 Nov 2026 03:39:01 +0000
Subject: [PATCH 12/27] tb710fu: enable USB-C DisplayPort output

The pmic-glink connector node and WCD9395 SBU mux are now present, so
the combo PHY aux bridge and the DP HPD bridge both probe.  mainline
msm_dp binds af54000.displayport-controller and exposes card*-DP-1;
verified 4K60 on the retail USB-C monitor with the internal DSI panel
still active.
---
 arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts | 12 ++----------
 1 file changed, 2 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
index 3dd1115c1..115cc4d37 100644
--- a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb710fu.dts
@@ -812,16 +812,8 @@
 };
 
 &mdss_dp0 {
-	/*
-	 * 关闭 DP：本板 USB-C DP 链路（88e8000.phy 的 aux bridge）在 DTB 里
-	 * 不完整，aux_bridge 取不到下游 drm_bridge，DP 控制器永久处于
-	 * deferred probe（waiting_for_supplier: 88e8000.phy）。而 DP0 接了
-	 * DPU 的输出端口，会被 add_display_components() 纳入 msm DRM master
-	 * 的 component 匹配表，导致 master 永远凑不齐 component、card0 不注册
-	 * （现象：背光亮但黑屏、/sys/class/drm 为空）。点屏阶段不需要外接屏，
-	 * 先关掉，让 master 仅由 DPU + 双 DSI + GPU 组成。
-	 */
-	status = "disabled";
+	/* USB-C DP Alt Mode: verified 4K60 on the retail monitor. */
+	status = "okay";
 };
 
 &spi4 {
