diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.c
new file mode 100644
index 000000000..982722e91
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.c
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <drm/drm_managed.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/seq_file.h>
+
+#include "msm_drv.h"
+#include "msm_gem.h"
+#include "dpu_hwio.h"
+#include "dpu_hw_reg_dma.h"
+
+/* Command words: opcode in the high bits of the first dword */
+#define SINGLE_REG_WRITE_OPCODE		BIT(28)
+#define LUTBUS_WRITE_OPCODE		(BIT(30) | BIT(29))
+#define NO_OP_OPCODE			0
+#define MAX_RELATIVE_OFF		(BIT(21) - 1)
+#define MAX_DWORDS_SZ			(BIT(14) - 1)
+#define LUTBUS_BLOCK_SEL_MASK		0x1ffff
+#define LUTBUS_TRANS_SZ_MASK		0xff0000
+#define LUTBUS_LUT_SIZE_MASK		0x3fff
+
+/* queue command word */
+#define CMD_WRITE			BIT(22)
+#define CMD_LAST			BIT(24)
+
+#define REG_DMA_OPMODE			0x4
+#define CTL_REG_DMA_TRIGGER		0xd4
+#define REG_DMA_ERROR_CLEAR_MASK	(BIT(0) | BIT(1) | BIT(2) | BIT(16) | \
+					 BIT(17) | BIT(18) | BIT(19))
+
+#define ADDR_ALIGN			BIT(8)
+#define GUARD_BYTES			(ADDR_ALIGN - 1)
+#define LAST_CMD_BUF_SIZE		(128 * sizeof(u32))
+#define DONE_TIMEOUT_US			2000
+
+/*
+ * Per-version register layout. The decode select is itself an absolute
+ * register write to the engine, so its address is part of the layout.
+ */
+struct dpu_reg_dma_layout {
+	u32 decode_sel;
+	u32 intr4_status;
+	u32 intr4_clear;
+	u32 (*queue0)(int ctl_idx);
+	u32 (*queue1)(int ctl_idx);
+	u32 (*intr_status)(int ctl_idx);
+	u32 (*intr_clear)(int ctl_idx);
+	u32 (*done_mask)(int ctl_idx);
+	u32 (*db_done_mask)(int ctl_idx);
+};
+
+static const u32 v2_done_mask[CTL_MAX] = {
+	[CTL_0] = BIT(21), [CTL_1] = BIT(22), [CTL_2] = BIT(23),
+	[CTL_3] = BIT(24), [CTL_4] = BIT(27), [CTL_5] = BIT(28),
+};
+
+static const u32 v2_db_done_mask[CTL_MAX] = {
+	[CTL_0] = BIT(16), [CTL_1] = BIT(17), [CTL_2] = BIT(18),
+	[CTL_3] = BIT(19), [CTL_4] = BIT(25), [CTL_5] = BIT(26),
+};
+
+static u32 v2_queue0(int ctl_idx) { return 0x14 + (ctl_idx - CTL_0) * 0x10; }
+static u32 v2_queue1(int ctl_idx) { return 0x1c + (ctl_idx - CTL_0) * 0x10; }
+static u32 v2_intr_status(int ctl_idx) { return 0x160; }
+static u32 v2_intr_clear(int ctl_idx) { return 0x1a0; }
+static u32 v2_done(int ctl_idx) { return v2_done_mask[ctl_idx]; }
+static u32 v2_db_done(int ctl_idx) { return v2_db_done_mask[ctl_idx]; }
+
+static const struct dpu_reg_dma_layout dpu_reg_dma_v2 = {
+	.decode_sel = 0x180ac114,
+	.intr4_status = 0x170,
+	.intr4_clear = 0x1b0,
+	.queue0 = v2_queue0,
+	.queue1 = v2_queue1,
+	.intr_status = v2_intr_status,
+	.intr_clear = v2_intr_clear,
+	.done_mask = v2_done,
+	.db_done_mask = v2_db_done,
+};
+
+/*
+ * v3: one 4 KiB window per CTL with its own queues, status and reset,
+ * numbered by CTL id, so CTL_0 uses the second window.
+ */
+static u32 v3_queue0(int ctl_idx) { return 0x1000 * ctl_idx; }
+static u32 v3_queue1(int ctl_idx) { return 0x1000 * ctl_idx + 0x8; }
+static u32 v3_intr_status(int ctl_idx) { return 0x1000 * ctl_idx + 0x44; }
+static u32 v3_intr_clear(int ctl_idx) { return 0x1000 * ctl_idx + 0x48; }
+static u32 v3_done(int ctl_idx) { return BIT(4); }
+static u32 v3_db_done(int ctl_idx) { return BIT(3); }
+
+static const struct dpu_reg_dma_layout dpu_reg_dma_v3 = {
+	.decode_sel = 0x18180114,
+	.intr4_status = 0x170,
+	.intr4_clear = 0x1b0,
+	.queue0 = v3_queue0,
+	.queue1 = v3_queue1,
+	.intr_status = v3_intr_status,
+	.intr_clear = v3_intr_clear,
+	.done_mask = v3_done,
+	.db_done_mask = v3_db_done,
+};
+
+int dpu_reg_dma_buf_alloc(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 size)
+{
+	u64 iova, aligned;
+	void *vaddr;
+
+	if (!size || (size / sizeof(u32)) > MAX_DWORDS_SZ)
+		return -EINVAL;
+
+	vaddr = msm_gem_kernel_new(dma->dev, size + GUARD_BYTES, MSM_BO_WC, dma->vm,
+				   &buf->bo, &iova);
+	if (IS_ERR(vaddr))
+		return PTR_ERR(vaddr);
+
+	aligned = ALIGN(iova, ADDR_ALIGN);
+	buf->iova = aligned;
+	buf->vaddr = vaddr + (aligned - iova);
+	buf->size = size;
+	buf->index = 0;
+	buf->ctl_idx = 0;
+	return 0;
+}
+
+void dpu_reg_dma_buf_free(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf)
+{
+	if (!buf->bo)
+		return;
+	msm_gem_kernel_put(buf->bo, dma->vm);
+	buf->bo = NULL;
+	buf->vaddr = NULL;
+	buf->iova = 0;
+}
+
+/*
+ * A buffer is rewritten in place, so wait for the transfer that last read
+ * it (the done bit is set by the flush-triggered transfer). On a timeout
+ * the buffer stays owned and the update is refused rather than rewriting
+ * live command memory; dpu_reg_dma_resume() drops the mark after a power
+ * collapse, the only case where the status register reads clear.
+ */
+int dpu_reg_dma_buf_wait(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf)
+{
+	u32 status;
+	int ret;
+
+	if (!buf->vaddr)
+		return -EINVAL;
+	if (!buf->ctl_idx)
+		return 0;
+
+	ret = read_poll_timeout(DPU_REG_READ, status,
+				status & dma->layout->done_mask(buf->ctl_idx),
+				10, DONE_TIMEOUT_US, false,
+				&dma->sb, dma->layout->intr_status(buf->ctl_idx));
+	if (ret) {
+		DRM_ERROR_RATELIMITED("LUTDMA ctl%d previous transfer not done (%#x)\n",
+				      buf->ctl_idx - CTL_0, status);
+		return -ETIMEDOUT;
+	}
+	buf->ctl_idx = 0;
+	return 0;
+}
+
+int dpu_reg_dma_buf_begin(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf)
+{
+	int ret = dpu_reg_dma_buf_wait(dma, buf);
+
+	if (ret)
+		return ret;
+	buf->index = 0;
+	return 0;
+}
+
+static __le32 *buf_reserve(struct dpu_reg_dma_buf *buf, u32 bytes)
+{
+	__le32 *loc;
+
+	if (buf->index + bytes > buf->size)
+		return NULL;
+	loc = (__le32 *)((u8 *)buf->vaddr + buf->index);
+	buf->index += bytes;
+	return loc;
+}
+
+static int write_decode_sel(struct dpu_reg_dma_buf *buf, u32 decode_sel, u32 sel)
+{
+	__le32 *loc = buf_reserve(buf, 2 * sizeof(u32));
+
+	if (!loc)
+		return -ENOSPC;
+	loc[0] = cpu_to_le32(decode_sel);
+	loc[1] = cpu_to_le32(sel);
+	return 0;
+}
+
+int dpu_reg_dma_single_write(struct dpu_reg_dma_buf *buf, u32 blk_offset, u32 val)
+{
+	__le32 *loc = buf_reserve(buf, 2 * sizeof(u32));
+
+	if (!loc)
+		return -ENOSPC;
+	loc[0] = cpu_to_le32(SINGLE_REG_WRITE_OPCODE | (blk_offset & MAX_RELATIVE_OFF));
+	loc[1] = cpu_to_le32(val);
+	return 0;
+}
+
+/*
+ * Queue a LUT bus write of len bytes and return its zeroed payload area for
+ * the caller to fill with little-endian LUT bus data.
+ */
+void *dpu_reg_dma_lut_reserve(struct dpu_reg_dma_buf *buf, u32 block_sel, u32 trans_size,
+			      u32 len)
+{
+	u32 beat = trans_size * sizeof(u32);
+	__le32 *loc, *tail;
+
+	if (len % beat)
+		return NULL;
+
+	loc = buf_reserve(buf, 2 * sizeof(u32) + len + 3 * sizeof(u32));
+	if (!loc)
+		return NULL;
+
+	loc[0] = cpu_to_le32(LUTBUS_WRITE_OPCODE | (block_sel & LUTBUS_BLOCK_SEL_MASK));
+	loc[1] = cpu_to_le32(((trans_size << 16) & LUTBUS_TRANS_SZ_MASK) |
+			     ((len / beat) & LUTBUS_LUT_SIZE_MASK));
+	memset(&loc[2], 0, len);
+
+	/* the engine needs residual data plus the next opcode to exceed four dwords */
+	tail = (__le32 *)((u8 *)&loc[2] + len);
+	tail[0] = cpu_to_le32(NO_OP_OPCODE);
+	tail[1] = cpu_to_le32(NO_OP_OPCODE);
+	tail[2] = cpu_to_le32(NO_OP_OPCODE);
+	return &loc[2];
+}
+
+/* the v3 layout maps one window per CTL and the catalog length bounds them */
+bool dpu_reg_dma_ctl_valid(struct dpu_reg_dma *dma, int ctl_idx)
+{
+	const struct dpu_reg_dma_layout *l = dma->layout;
+	u32 sb_len = dma->cfg->len - dma->cfg->sb_off;
+
+	if (ctl_idx < CTL_0 || ctl_idx >= CTL_MAX)
+		return false;
+	return l->queue1(ctl_idx) + 2 * sizeof(u32) <= sb_len &&
+	       l->intr_status(ctl_idx) + sizeof(u32) <= sb_len &&
+	       l->intr_clear(ctl_idx) + sizeof(u32) <= sb_len;
+}
+
+static int kick_off(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf,
+		    bool db, bool last)
+{
+	const struct dpu_reg_dma_layout *l = dma->layout;
+	struct dpu_hw_blk_reg_map *win = db ? &dma->db : &dma->sb;
+	u32 queue, cmd1, status;
+
+	if (!dpu_reg_dma_ctl_valid(dma, ctl_idx) || !buf->iova || !buf->index)
+		return -EINVAL;
+	queue = db ? l->queue0(ctl_idx) : l->queue1(ctl_idx);
+
+	/* the command buffer is write-combined; publish it before the engine reads it */
+	wmb();
+
+	cmd1 = CMD_WRITE | ((buf->index / sizeof(u32)) & MAX_DWORDS_SZ);
+	if (last)
+		cmd1 |= CMD_LAST;
+
+	DPU_REG_WRITE(win, REG_DMA_OPMODE, BIT(0));
+	status = DPU_REG_READ(win, l->intr4_status);
+	if (status) {
+		DRM_ERROR_RATELIMITED("LUTDMA error status %#x\n", status);
+		DPU_REG_WRITE(win, l->intr4_clear, REG_DMA_ERROR_CLEAR_MASK);
+	}
+
+	DPU_REG_WRITE(win, queue, lower_32_bits(buf->iova));
+	DPU_REG_WRITE(win, queue + 0x4, cmd1);
+	if (!db)
+		buf->ctl_idx = ctl_idx;
+
+	if (last) {
+		/* the last-command descriptor must be queued before the done bit is armed */
+		wmb();
+		DPU_REG_WRITE(win, l->intr_clear(ctl_idx),
+			      db ? l->db_done_mask(ctl_idx) : l->done_mask(ctl_idx));
+	}
+	return 0;
+}
+
+int dpu_reg_dma_kick_off_sb(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf)
+{
+	return kick_off(dma, ctl_idx, buf, false, false);
+}
+
+int dpu_reg_dma_kick_off_db(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf)
+{
+	return kick_off(dma, ctl_idx, buf, true, false);
+}
+
+/*
+ * Close the sideband queue for this CTL: a last-command descriptor tells the
+ * engine the batch is complete, and the DSPP_SB flush then starts it.
+ */
+int dpu_reg_dma_last_cmd_sb(struct dpu_reg_dma *dma, int ctl_idx)
+{
+	struct dpu_reg_dma_buf *buf;
+	int ret;
+
+	if (!dpu_reg_dma_ctl_valid(dma, ctl_idx))
+		return -EINVAL;
+
+	buf = &dma->last_cmd[ctl_idx];
+	ret = dpu_reg_dma_buf_begin(dma, buf);
+	if (ret)
+		return ret;
+	ret = write_decode_sel(buf, dma->layout->decode_sel, 0);
+	if (ret)
+		return ret;
+
+	return kick_off(dma, ctl_idx, buf, false, true);
+}
+
+/*
+ * The double-buffered queue runs on a software trigger rather than a flush:
+ * close it, start it, and wait so the registers it writes are in place
+ * before the CTL flush that latches them.
+ */
+int dpu_reg_dma_flush_db(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_hw_blk_reg_map *ctl_hw)
+{
+	struct dpu_reg_dma_buf *buf = &dma->last_cmd_db[ctl_idx];
+	u32 status;
+	int ret;
+
+	if (!dpu_reg_dma_ctl_valid(dma, ctl_idx) || !buf->vaddr)
+		return -EINVAL;
+	if (dma->db_stuck)
+		return -EBUSY;
+
+	buf->index = 0;
+	ret = write_decode_sel(buf, dma->layout->decode_sel, 0);
+	if (!ret)
+		ret = kick_off(dma, ctl_idx, buf, true, true);
+	if (ret)
+		return ret;
+
+	DPU_REG_WRITE(ctl_hw, CTL_REG_DMA_TRIGGER, BIT(0));
+	ret = read_poll_timeout(DPU_REG_READ, status, status & dma->layout->db_done_mask(ctl_idx),
+				10, DONE_TIMEOUT_US, false,
+				&dma->db, dma->layout->intr_status(ctl_idx));
+	/* the engine may still be reading the queued buffers; stop rewriting them */
+	if (ret)
+		dma->db_stuck = true;
+	return ret;
+}
+
+int dpu_reg_dma_decode_sel(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 sel)
+{
+	return write_decode_sel(buf, dma->layout->decode_sel, sel);
+}
+
+static bool transfer_done(struct dpu_reg_dma *dma, int ctl_idx)
+{
+	u32 status = DPU_REG_READ(&dma->sb, dma->layout->intr_status(ctl_idx));
+
+	return status & dma->layout->done_mask(ctl_idx);
+}
+
+void dpu_reg_dma_debugfs_show(struct dpu_reg_dma *dma, struct seq_file *s)
+{
+	const struct dpu_reg_dma_layout *l = dma->layout;
+	int i;
+
+	seq_printf(s, "engine v%x sb_off %#x\n", dma->cfg->version, dma->cfg->sb_off);
+	seq_printf(s, "opmode %#010x intr4_status %#010x\n",
+		   DPU_REG_READ(&dma->sb, REG_DMA_OPMODE), DPU_REG_READ(&dma->sb, l->intr4_status));
+	for (i = CTL_0; i < CTL_MAX; i++) {
+		if (!dpu_reg_dma_ctl_valid(dma, i))
+			continue;
+		if (!dma->last_cmd[i].iova)
+			continue;
+		seq_printf(s, "ctl%d q1 addr %#010x cmd %#010x intr_status %#010x done %d last_cmd iova %#llx\n",
+			   i - CTL_0, DPU_REG_READ(&dma->sb, l->queue1(i)),
+			   DPU_REG_READ(&dma->sb, l->queue1(i) + 4),
+			   DPU_REG_READ(&dma->sb, l->intr_status(i)), transfer_done(dma, i),
+			   dma->last_cmd[i].iova);
+	}
+}
+
+struct dpu_reg_dma *dpu_reg_dma_init(struct drm_device *dev, struct drm_gpuvm *vm,
+				     void __iomem *base, const struct dpu_reg_dma_cfg *cfg)
+{
+	struct dpu_reg_dma *dma;
+	int i, ret;
+
+	dma = drmm_kzalloc(dev, sizeof(*dma), GFP_KERNEL);
+	if (!dma)
+		return ERR_PTR(-ENOMEM);
+
+	switch (cfg->version) {
+	case DPU_REG_DMA_VER_2_0:
+		dma->layout = &dpu_reg_dma_v2;
+		break;
+	case DPU_REG_DMA_VER_3_0:
+		dma->layout = &dpu_reg_dma_v3;
+		break;
+	default:
+		return ERR_PTR(-EOPNOTSUPP);
+	}
+
+	dma->dev = dev;
+	dma->vm = vm;
+	dma->cfg = cfg;
+	dma->sb.blk_addr = base + cfg->sb_off;
+	dma->sb.log_mask = DPU_DBG_MASK_TOP;
+	dma->db.blk_addr = base + cfg->db_off;
+	dma->db.log_mask = DPU_DBG_MASK_TOP;
+
+	for (i = CTL_0; i < CTL_MAX; i++) {
+		ret = dpu_reg_dma_buf_alloc(dma, &dma->last_cmd[i], LAST_CMD_BUF_SIZE);
+		if (!ret)
+			ret = dpu_reg_dma_buf_alloc(dma, &dma->last_cmd_db[i], LAST_CMD_BUF_SIZE);
+		if (ret) {
+			dpu_reg_dma_destroy(dma);
+			return ERR_PTR(ret);
+		}
+	}
+
+	return dma;
+}
+
+/* The engine lost its state with the power domain; nothing is in flight */
+void dpu_reg_dma_resume(struct dpu_reg_dma *dma)
+{
+	int i;
+
+	for (i = CTL_0; i < CTL_MAX; i++)
+		dma->last_cmd[i].ctl_idx = 0;
+	dma->db_stuck = false;
+}
+
+/* Must run while the display VM is still alive */
+void dpu_reg_dma_destroy(struct dpu_reg_dma *dma)
+{
+	int i;
+
+	for (i = CTL_0; i < CTL_MAX; i++) {
+		dpu_reg_dma_buf_free(dma, &dma->last_cmd[i]);
+		dpu_reg_dma_buf_free(dma, &dma->last_cmd_db[i]);
+	}
+}
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.h
new file mode 100644
index 000000000..0e0725810
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * LUTDMA: the DPU's LUT DMA engine. Color LUT blocks on DPU 9.x and later
+ * (DSPP IGC and gamut, VIG IGC and gamut) have no memory-mapped write path;
+ * their tables are streamed over a LUT bus by this engine from a command
+ * buffer in the display IOMMU domain. The sideband (SB) queue is triggered
+ * by the CTL's DSPP_SB flush, so a transfer lands with the frame it was
+ * queued for.
+ */
+
+#ifndef _DPU_HW_REG_DMA_H
+#define _DPU_HW_REG_DMA_H
+
+#include <linux/types.h>
+#include "dpu_hw_mdss.h"
+#include "dpu_hw_catalog.h"
+#include "dpu_hw_util.h"
+
+struct drm_device;
+struct seq_file;
+struct drm_gpuvm;
+struct drm_gem_object;
+
+/* LUT bus block select for the LUT write command */
+#define DPU_LUTBUS_BLOCK_IGC		0
+#define DPU_LUTBUS_BLOCK_GAMUT		1
+/* second of the two tables of a double-banked LUT bus block */
+#define DPU_LUTBUS_TABLE_B		BIT(16)
+/* LUT bus transfer sizes, in dwords per beat */
+#define DPU_LUTBUS_IGC_TRANS_SIZE	3
+#define DPU_LUTBUS_GAMUT_TRANS_SIZE	6
+
+/* decode select bits */
+#define DPU_REG_DMA_SEL_VIG(n)		BIT(n)
+#define DPU_REG_DMA_SEL_DSPP(n)		BIT(17 + (n))
+
+#define DPU_REG_DMA_VER_2_0		0x20000
+#define DPU_REG_DMA_VER_3_0		0x30000
+
+struct dpu_reg_dma_buf {
+	struct drm_gem_object *bo;
+	u64 iova;
+	void *vaddr;
+	u32 size;
+	u32 index;
+	/* CTL whose sideband queue last consumed this buffer, 0 for none */
+	int ctl_idx;
+};
+
+struct dpu_reg_dma_layout;
+
+struct dpu_reg_dma {
+	struct drm_device *dev;
+	struct drm_gpuvm *vm;
+	struct dpu_hw_blk_reg_map sb;
+	struct dpu_hw_blk_reg_map db;
+	const struct dpu_reg_dma_cfg *cfg;
+	const struct dpu_reg_dma_layout *layout;
+	struct dpu_reg_dma_buf last_cmd[CTL_MAX];
+	struct dpu_reg_dma_buf last_cmd_db[CTL_MAX];
+	/* a double-buffered transfer timed out; cleared by power collapse */
+	bool db_stuck;
+};
+
+struct dpu_reg_dma *dpu_reg_dma_init(struct drm_device *dev, struct drm_gpuvm *vm,
+				     void __iomem *base, const struct dpu_reg_dma_cfg *cfg);
+void dpu_reg_dma_resume(struct dpu_reg_dma *dma);
+void dpu_reg_dma_debugfs_show(struct dpu_reg_dma *dma, struct seq_file *s);
+void dpu_reg_dma_destroy(struct dpu_reg_dma *dma);
+int dpu_reg_dma_buf_alloc(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 size);
+void dpu_reg_dma_buf_free(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf);
+
+/*
+ * Command buffer construction. dpu_reg_dma_buf_begin() waits for the
+ * buffer's previous transfer before it is rewritten.
+ */
+int dpu_reg_dma_buf_wait(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf);
+int dpu_reg_dma_buf_begin(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf);
+int dpu_reg_dma_decode_sel(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 sel);
+int dpu_reg_dma_single_write(struct dpu_reg_dma_buf *buf, u32 blk_offset, u32 val);
+void *dpu_reg_dma_lut_reserve(struct dpu_reg_dma_buf *buf, u32 block_sel, u32 trans_size,
+			      u32 len);
+
+bool dpu_reg_dma_ctl_valid(struct dpu_reg_dma *dma, int ctl_idx);
+int dpu_reg_dma_kick_off_sb(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf);
+int dpu_reg_dma_last_cmd_sb(struct dpu_reg_dma *dma, int ctl_idx);
+
+int dpu_reg_dma_kick_off_db(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf);
+int dpu_reg_dma_flush_db(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_hw_blk_reg_map *ctl_hw);
+
+#endif /* _DPU_HW_REG_DMA_H */
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_sspp.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_sspp.c
index b5e50fc19..854e39c41 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_sspp.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_sspp.c
@@ -10,8 +10,10 @@
 #include "dpu_hw_sspp.h"
 #include "dpu_kms.h"
 
+#include <drm/drm_color_mgmt.h>
 #include <drm/drm_file.h>
 #include <drm/drm_managed.h>
+#include <drm/drm_property.h>
 
 #include <linux/soc/qcom/ubwc.h>
 
@@ -755,3 +757,158 @@ struct dpu_hw_sspp *dpu_hw_sspp_init(struct drm_device *dev,
 
 	return hw_pipe;
 }
+
+/*
+ * VIG IGC v6 and gamut v6.1 (SM8550, SM8650, SM8750), loaded through the
+ * LUTDMA double-buffered queue, which addresses the pipe from lut_top_off.
+ * The shared opmode register holds the gamut mode and enable in bits 4:0
+ * and the IGC enable and bank in bits 9:8. Each block has two banks: the
+ * idle one is written and the opmode, latched by the pipe's flush,
+ * switches to it.
+ */
+#define LUT_GAMUT_EN		BIT(0)
+#define LUT_GAMUT_MODE_17B	(4 << 2)
+#define LUT_GAMUT_MASK		GENMASK(4, 0)
+#define LUT_IGC_EN		BIT(8)
+#define LUT_IGC_BANK		BIT(9)
+#define LUT_IGC_INDEX		0x1b0
+#define LUT_IGC_DATA(c)		(0x1b4 + 4 * (c))
+#define LUT_IGC_DITHER		0x1c0
+#define LUT_IGC_LAST(c)		(0x1c4 + 4 * (c))
+#define LUT_IGC_WORDS		((DPU_SSPP_IGC_SIZE - 1) / 2)
+#define LUT_GAMUT_TBL_NUM	4
+#define LUT_GAMUT_TBL_LEN	1229
+#define LUT_GAMUT_NODES		(DPU_SSPP_LUT3D_EDGE * DPU_SSPP_LUT3D_EDGE * DPU_SSPP_LUT3D_EDGE)
+#define LUT_GAMUT_LEN		(LUT_GAMUT_TBL_NUM * LUT_GAMUT_TBL_LEN * 3 * sizeof(u16))
+#define LUT_OP_SIZE		(2 * sizeof(u32))
+#define LUT_BUF_SIZE		(LUT_GAMUT_LEN + 5 * sizeof(u32) + \
+				 (3 * (LUT_IGC_WORDS + 2) + 4) * LUT_OP_SIZE)
+
+static u32 igc_val(const struct drm_color_lut32 *lut, int i, int chan)
+{
+	u32 v = chan == 0 ? lut[i].red : chan == 1 ? lut[i].green : lut[i].blue;
+
+	return drm_color_lut32_extract(v, 12);
+}
+
+static int queue_gamut(struct dpu_hw_sspp *ctx, const struct drm_color_lut32 *lut,
+		       bool table_b)
+{
+	struct dpu_reg_dma_buf *buf = &ctx->lut_buf;
+	__le16 *data;
+	int n, k;
+
+	data = dpu_reg_dma_lut_reserve(buf, DPU_LUTBUS_BLOCK_GAMUT |
+				       (table_b ? DPU_LUTBUS_TABLE_B : 0),
+				       DPU_LUTBUS_GAMUT_TRANS_SIZE, LUT_GAMUT_LEN);
+	if (!data)
+		return -ENOSPC;
+
+	/* same node stream and component order as the DSPP gamut, 10 bits MSB aligned */
+	for (n = 0, k = 0; n < LUT_GAMUT_NODES; n++) {
+		data[k++] = cpu_to_le16(drm_color_lut32_extract(lut[n].red, 10) << 6);
+		data[k++] = cpu_to_le16(drm_color_lut32_extract(lut[n].green, 10) << 6);
+		data[k++] = cpu_to_le16(drm_color_lut32_extract(lut[n].blue, 10) << 6);
+	}
+	return 0;
+}
+
+/* ports c0, c1, c2 carry green, blue, red, as the DSPP IGC does */
+static int queue_igc(struct dpu_hw_sspp *ctx, u32 blk, const struct drm_color_lut32 *lut)
+{
+	static const int chans[3] = { 1, 2, 0 };
+	struct dpu_reg_dma_buf *buf = &ctx->lut_buf;
+	int c, j, ret = 0;
+
+	for (c = 0; c < 3 && !ret; c++) {
+		int chan = chans[c];
+
+		ret = dpu_reg_dma_single_write(buf, blk + LUT_IGC_INDEX, 0);
+		for (j = 0; j < LUT_IGC_WORDS && !ret; j++)
+			ret = dpu_reg_dma_single_write(buf, blk + LUT_IGC_DATA(c),
+						       igc_val(lut, 2 * j, chan) |
+						       igc_val(lut, 2 * j + 1, chan) << 16);
+		if (!ret)
+			ret = dpu_reg_dma_single_write(buf, blk + LUT_IGC_LAST(c),
+						       igc_val(lut, DPU_SSPP_IGC_SIZE - 1, chan));
+	}
+	return ret ? ret : dpu_reg_dma_single_write(buf, blk + LUT_IGC_DITHER, 0);
+}
+
+int dpu_hw_sspp_setup_luts(struct dpu_hw_sspp *ctx, struct drm_property_blob *igc,
+			   struct drm_property_blob *lut3d, int ctl_idx)
+{
+	const struct dpu_sspp_sub_blks *sblk = ctx->cap->sblk;
+	struct dpu_reg_dma_buf *buf = &ctx->lut_buf;
+	u32 blk = DPU_SSPP_LUT_OPMODE - sblk->lut_top_off;
+	u32 opmode = 0;
+	int ret;
+
+	if (ctx->reg_dma->db_stuck)
+		return -EBUSY;
+
+	ret = dpu_reg_dma_buf_begin(ctx->reg_dma, buf);
+	if (!ret)
+		ret = dpu_reg_dma_decode_sel(ctx->reg_dma, buf,
+					     DPU_REG_DMA_SEL_VIG(ctx->idx - SSPP_VIG0));
+
+	if (!ret && lut3d) {
+		bool table_b = (ctx->lut_opmode & LUT_GAMUT_MASK) == LUT_GAMUT_EN;
+
+		ret = queue_gamut(ctx, lut3d->data, table_b);
+		opmode |= LUT_GAMUT_EN | (table_b ? LUT_GAMUT_MODE_17B : 0);
+	}
+
+	if (!ret && igc) {
+		ret = queue_igc(ctx, blk, igc->data);
+		opmode |= LUT_IGC_EN;
+		if (ctx->lut_opmode & LUT_IGC_EN)
+			opmode |= ~ctx->lut_opmode & LUT_IGC_BANK;
+		else
+			opmode |= ctx->lut_opmode & LUT_IGC_BANK;
+	}
+
+	if (!ret)
+		ret = dpu_reg_dma_single_write(buf, blk, opmode);
+	if (!ret)
+		ret = dpu_reg_dma_kick_off_db(ctx->reg_dma, ctl_idx, buf);
+	if (ret)
+		return ret;
+
+	ctx->lut_opmode = opmode;
+	drm_property_replace_blob(&ctx->igc, igc);
+	drm_property_replace_blob(&ctx->lut3d, lut3d);
+	return 0;
+}
+
+/* the LUT RAM and opmode are lost with the power domain */
+void dpu_hw_sspp_lut_reset(struct dpu_hw_sspp *ctx)
+{
+	ctx->lut_opmode = 0;
+	drm_property_replace_blob(&ctx->igc, NULL);
+	drm_property_replace_blob(&ctx->lut3d, NULL);
+}
+
+int dpu_hw_sspp_set_reg_dma(struct dpu_hw_sspp *ctx, struct dpu_reg_dma *reg_dma)
+{
+	int ret;
+
+	if (!ctx->cap->sblk->lut_top_off)
+		return 0;
+
+	ret = dpu_reg_dma_buf_alloc(reg_dma, &ctx->lut_buf, LUT_BUF_SIZE);
+	if (ret)
+		return ret;
+	ctx->reg_dma = reg_dma;
+	return 0;
+}
+
+void dpu_hw_sspp_clear_reg_dma(struct dpu_hw_sspp *ctx)
+{
+	if (!ctx->reg_dma)
+		return;
+
+	dpu_hw_sspp_lut_reset(ctx);
+	dpu_reg_dma_buf_free(ctx->reg_dma, &ctx->lut_buf);
+	ctx->reg_dma = NULL;
+}
