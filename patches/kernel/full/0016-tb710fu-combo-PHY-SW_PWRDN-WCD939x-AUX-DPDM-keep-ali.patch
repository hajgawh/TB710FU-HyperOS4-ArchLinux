 	struct clk_hw dp_pixel_hw;
@@ -4164,7 +4172,13 @@ static int qmp_combo_dp_exit(struct phy *phy)
 
 	qmp_combo_com_exit(qmp, false);
 
-	qmp->dp_init_count--;
+	if (qmp->dp_init_count)
+		qmp->dp_init_count--;
+
+	/* Replay a mux switch that was deferred while DP owned the PHY.
+	 * The work runs outside phy_mutex (we hold it here) and re-takes it. */
+	if (!qmp->dp_init_count && qmp->tb_mux_pending)
+		schedule_work(&qmp->tb_mux_work);
 
 	mutex_unlock(&qmp->phy_mutex);
 
@@ -4214,6 +4228,8 @@ static int qmp_combo_dp_power_off(struct phy *phy)
 	return 0;
 }
 
+static void qmp_combo_tb_wait_usb3(struct qmp_combo *qmp);
+
 static int qmp_combo_usb_power_on(struct phy *phy)
 {
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
@@ -4229,6 +4245,28 @@ static int qmp_combo_usb_power_on(struct phy *phy)
 	unsigned int val;
 	int ret;
 
+	qmp_combo_tb_wait_usb3(qmp);
+
+	/*
+	 * TB710FU: keep the USB3 PCS powered when the DP side still holds a
+	 * reference to the shared COM block.
+	 *
+	 * qmp_combo_com_init() is the only place that sets SW_PWRDN, but it
+	 * returns early as soon as init_count is non-zero - and the DP
+	 * bridge keeps its phy_init() reference across system suspend
+	 * (keep_link).  qmp_combo_usb_power_off() drops SW_PWRDN on the way
+	 * into suspend, so without this the PCS stays powered down,
+	 * PCS_STATUS1.PHYSTATUS never clears and phy_init() fails with
+	 * -ETIMEDOUT on every resume; the first DP commit after resume then
+	 * touches an unpowered PHY and hangs the SoC.
+	 *
+	 * Idempotent on the full-init path (com_init() already set the bit).
+	 * Skipped in DP-only mode, where the USB PCS must stay down.
+	 */
+	if (READ_ONCE(qmp->qmpphy_mode) != QMPPHY_MODE_DP_ONLY)
+		qphy_setbits(pcs, cfg->regs[QPHY_PCS_POWER_DOWN_CONTROL],
+			     SW_PWRDN);
+
 	qmp_configure(qmp->dev, serdes, cfg->serdes_tbl, cfg->serdes_tbl_num);
 
 	/* Tx, Rx, and PCS configurations */
